---
import Wordmark from './Wordmark.astro';
import { SITE } from '../lib/site.config.mjs';
import { COPY } from '../data/copy';
import { directionsUrl, primaryPhone, type Branch } from '../lib/content';
import { asset, href } from '../lib/href';

/**
 * The footer is the carriage doors.
 *
 * Reyy's briefing asks for the footer to be built on a subway-train-door
 * concept, and it is not an arbitrary reference: one of Le SMASH's rooms is
 * fitted out as a carriage — red bench seats, ring handles, poles. So the last
 * thing on every page is a pair of carriage doors that slide open as you
 * arrive, with the stop board above reading "Next stop: Le SMASH".
 *
 * The doors are an overlay on the footer, not extra height in front of it: they
 * open across the content and come to rest as the door frames at either edge.
 * Without script, or with reduced motion, they are simply open.
 *
 * Ordering lives here (the client's call): one Foodpanda button per room that
 * has a listing, plus the brand phone. Social links go outward only.
 */
interface Props { branches: Branch[] }
const { branches } = Astro.props;

const socials = [
  { label: 'Instagram', href: SITE.social.instagram },
  { label: 'Facebook', href: SITE.social.facebook },
  { label: 'TikTok', href: SITE.social.tiktok },
].filter((s) => s.href);

const pages = [
  ['/', COPY.nav.home], ['/story', COPY.nav.story], ['/menu', COPY.nav.menu],
  ['/gallery', COPY.nav.gallery], ['/collaborations', COPY.nav.collaborations],
  ['/merch', COPY.nav.merch], ['/visit', COPY.nav.visit],
] as const;

const order = branches.filter((b) => b.foodpandaUrl);
const year = new Date().getFullYear();
const stop = ['Next stop', 'Le SMASH', 'Mind the gap', 'Smashed to order'];
---
<footer class="ftr dark" id="visit-footer" data-doors>
  <div class="grain" aria-hidden="true"></div>

  {/* Overhead: the handrail with its rings, and the stop board. */}
  <div class="ftr__rail" aria-hidden="true">
    {Array.from({ length: 9 }, () => <span class="ring"><i></i></span>)}
  </div>
  <div class="ftr__board" aria-hidden="true">
    <div class="ftr__board-track">
      {[0, 1, 2].map(() => stop.map((t) => <span>{t}</span>))}
    </div>
  </div>

  <div class="ftr__car">
    <div class="wrap">
      {order.length > 0 && (
        <div class="ftr__order">
          <div>
            <p class="label">Order in</p>
            <p class="ftr__order-head">Smashed, <span class="script">delivered.</span></p>
          </div>
          <div class="ftr__order-btns">
            {order.map((b) => (
              <a class="ftr__panda" href={b.foodpandaUrl!} target="_blank" rel="noopener noreferrer"
                 data-analytics="order_click" data-branch={b.slug} data-source="footer">
                <span class="ftr__panda-room">{b.name}</span>
                <span class="ftr__panda-via">Order on foodpanda <span aria-hidden="true">→</span></span>
              </a>
            ))}
            {SITE.phone && (
              <a class="ftr__panda ftr__panda--call" href={'tel:' + SITE.phone.e164}
                 data-analytics="phone_click" data-source="footer">
                <span class="ftr__panda-room">Call us</span>
                <span class="ftr__panda-via">{SITE.phone.display}</span>
              </a>
            )}
          </div>
        </div>
      )}

      <div class="ftr__grid">
        <div>
          <Wordmark size="lg" />
          <p class="lede" style="margin-top:var(--s4)">
            American flavour. French precision. Born in {SITE.geo}.
          </p>
        </div>

        <div>
          <p class="label">{COPY.labels.branches}</p>
          <ul class="ftr__list" style="margin-top:var(--s4)">
            {branches.map((branch) => {
              const phone = primaryPhone(branch);
              return (
                <li>
                  <strong class="ftr__room">{branch.name}</strong>
                  <span class="ftr__addr">{branch.addressLine}, {branch.township}, {branch.city}</span>
                  <span style="display:block;margin-top:6px">
                    <a href={directionsUrl(branch)} target="_blank" rel="noopener noreferrer"
                       data-analytics="directions_click" data-branch={branch.slug} data-source="footer">
                      {COPY.cta.directions}
                    </a>
                    {phone && <> · <a href={`tel:${phone.e164}`} data-analytics="phone_click"
                       data-branch={branch.slug} data-source="footer">{phone.display}</a></>}
                  </span>
                </li>
              );
            })}
          </ul>
        </div>

        <div class="ftr__split">
          <div>
            <p class="label">{COPY.footer.follow}</p>
            <ul class="ftr__list" style="margin-top:var(--s4)">
              {socials.map((s) => (
                <li>
                  <a href={s.href!} target="_blank" rel="noopener noreferrer"
                     data-analytics="social_click" data-platform={s.label.toLowerCase()}>{s.label}</a>
                </li>
              ))}
            </ul>
          </div>
          <div>
            <p class="label">Pages</p>
            <ul class="ftr__list" style="margin-top:var(--s4)">
              {pages.map(([p, label]) => <li><a href={href(p)}>{label}</a></li>)}
            </ul>
          </div>
        </div>
      </div>

      <div class="ftr__bottom">
        <span>&copy; {year} {SITE.brand.legal}</span>
        <span>{SITE.geo}, Myanmar</span>
        <a class="ftr__by" href="https://astermade.com" target="_blank" rel="noopener noreferrer"
           data-analytics="agency_credit_click">
          <img src={asset('/brand/aster-mark.png')} alt="" width="96" height="96"
               loading="lazy" decoding="async" />
          <span>Made by <strong>Aster</strong></span>
        </a>
      </div>
    </div>

    {/* The doors. Decorative, so hidden from assistive tech and click-through
        once they start to open. */}
    <div class="doors" aria-hidden="true">
      <div class="door door--l"><span class="door__win"></span><span class="door__decal">Le</span></div>
      <div class="door door--r"><span class="door__win"></span><span class="door__decal">SMASH</span></div>
    </div>
  </div>
</footer>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  const ftr = document.querySelector<HTMLElement>('[data-doors]');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (ftr && !reduce) {
    gsap.registerPlugin(ScrollTrigger);
    const left = ftr.querySelector('.door--l');
    const right = ftr.querySelector('.door--r');
    const doors = ftr.querySelector<HTMLElement>('.doors');

    // Arm: the doors start closed only once script is known to be running.
    ftr.classList.add('is-armed');

    const tl = gsap.timeline({
      scrollTrigger: {
        trigger: ftr,
        start: 'top 92%',
        end: 'top 30%',
        scrub: 0.6,
        onUpdate: (self) => {
          // Clicks pass through as soon as there is a gap to click through.
          if (doors) doors.style.pointerEvents = self.progress > 0.15 ? 'none' : 'auto';
        },
      },
    });
    // A short hold, then the slide: carriage doors part, pause, and run open.
    tl.to([left, right], { xPercent: (i) => (i ? 6 : -6), duration: 0.25, ease: 'power1.out' })
      .to(left, { xPercent: -94, duration: 1, ease: 'power2.inOut' }, '>-0.02')
      .to(right, { xPercent: 94, duration: 1, ease: 'power2.inOut' }, '<');

    // The rings swing with how fast you scroll, and settle.
    const rings = ftr.querySelectorAll('.ring');
    let swing = 0;
    ScrollTrigger.create({
      trigger: ftr,
      start: 'top bottom',
      end: 'bottom top',
      onUpdate: (self) => {
        swing = gsap.utils.clamp(-18, 18, self.getVelocity() / -120);
        gsap.to(rings, {
          rotate: (i) => swing * (i % 2 ? 0.8 : 1),
          duration: 0.5, ease: 'power2.out', overwrite: true,
          onComplete: () => { gsap.to(rings, { rotate: 0, duration: 1.6, ease: 'elastic.out(1, 0.3)' }); },
        });
      },
    });
  }
</script>
