---
import Wordmark from './Wordmark.astro';
import { SITE } from '../lib/site.config.mjs';
import { COPY } from '../data/copy';
import { directionsUrl, primaryPhone, type Branch } from '../lib/content';
import { asset, href } from '../lib/href';

/**
 * Carries the full name, address and phone for every branch. That is what
 * lets the site drop a separate contact page, and it is what a customer needs
 * when Facebook is unreachable. Social links go outward only — no SDK, no
 * embed, no pixel.
 */
interface Props { branches: Branch[] }
const { branches } = Astro.props;

const socials = [
  { label: 'Instagram', href: SITE.social.instagram },
  { label: 'Facebook', href: SITE.social.facebook },
  { label: 'TikTok', href: SITE.social.tiktok },
].filter((s) => s.href);

const year = new Date().getFullYear();
---
<footer class="ftr dark" id="visit-footer">
  <div class="grain" aria-hidden="true"></div>
  <div class="wrap">
    <div class="ftr__grid">
      <div>
        <Wordmark size="lg" />
        <p class="lede" style="margin-top:var(--s4)">
          American flavour. French precision. Born in {SITE.geo}.
        </p>
      </div>

      <div>
        <p class="label">{COPY.labels.branches}</p>
        <ul class="ftr__list" style="margin-top:var(--s4)">
          {branches.map((branch) => {
            const phone = primaryPhone(branch);
            return (
              <li>
                <strong style="display:block;font-family:var(--font-body);color:var(--ink)">
                  {branch.name}
                </strong>
                <span style="color:var(--ink-2);font-size:var(--t-sm)">
                  {branch.addressLine}, {branch.township}, {branch.city}
                </span>
                <span style="display:block;margin-top:6px">
                  <a href={directionsUrl(branch)} target="_blank" rel="noopener noreferrer"
                     data-analytics="directions_click" data-branch={branch.slug} data-source="footer">
                    {COPY.cta.directions}
                  </a>
                  {phone && <> · <a href={`tel:${phone.e164}`} data-analytics="phone_click"
                     data-branch={branch.slug} data-source="footer">{phone.display}</a></>}
                </span>
              </li>
            );
          })}
        </ul>
      </div>

      <div>
        <p class="label">{COPY.footer.follow}</p>
        <ul class="ftr__list" style="margin-top:var(--s4)">
          {socials.map((s) => (
            <li>
              <a href={s.href!} target="_blank" rel="noopener noreferrer"
                 data-analytics="social_click" data-platform={s.label.toLowerCase()}>{s.label}</a>
            </li>
          ))}
        </ul>

        <p class="label" style="margin-top:var(--s6)">Pages</p>
        <ul class="ftr__list" style="margin-top:var(--s4)">
          <li><a href={href("/")}>{COPY.nav.home}</a></li>
          <li><a href={href("/#story")}>{COPY.nav.story}</a></li>
          <li><a href={href("/menu")}>{COPY.nav.menu}</a></li>
          <li><a href={href("/gallery")}>{COPY.nav.gallery}</a></li>
          <li><a href={href("/visit")}>{COPY.nav.visit}</a></li>
        </ul>
      </div>
    </div>

    <p class="ftr__wordmark" aria-hidden="true">SMASH</p>

    <div class="ftr__bottom">
      <span>&copy; {year} {SITE.brand.legal}</span>
      <span>{SITE.geo}, Myanmar</span>
      <a class="ftr__by" href="https://astermade.com" target="_blank" rel="noopener noreferrer"
         data-analytics="agency_credit_click">
        <img src={asset('/brand/aster-mark.png')} alt="" width="96" height="96"
             loading="lazy" decoding="async" />
        <span>Made by <strong>Aster</strong></span>
      </a>
    </div>
  </div>
</footer>
