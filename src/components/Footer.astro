---
import { localePath, LOCALE_LABEL, otherLocale, SITE, type Locale } from '../lib/i18n';
import { navItems } from '../lib/nav';
import { t } from '../data/copy';
import { L, primaryPhone, type Branch } from '../lib/content';

/**
 * The footer carries the full NAP for every branch. That is deliberate: it is
 * what lets us drop a separate /contact page (PRD §9.4), and it is the thing a
 * customer needs when Facebook is unreachable (PRD §5.3).
 *
 * Social links go outward only — no SDK, no embed, no pixel (SOC-01).
 */
interface Props { locale: Locale; branches: Branch[]; route: string }
const { locale, branches, route } = Astro.props;
const c = t(locale);
const other = otherLocale(locale);
const socials = [
  { label: 'Facebook', href: SITE.social.facebook },
  { label: 'Instagram', href: SITE.social.instagram },
  { label: 'TikTok', href: SITE.social.tiktok },
].filter((s) => s.href);
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <h2>{SITE.brand.legal}</h2>
        <p style="color:#c3b7a7;font-size:var(--step--1)">{c.footer.deliveryVia}</p>
        {socials.length > 0 && (
          <>
            <h2 style="margin-top:1.5rem;font-size:var(--step-0)">{c.footer.followUs}</h2>
            <ul class="footer-list">
              {socials.map((s) => (
                <li>
                  <a href={s.href!} target="_blank" rel="noopener noreferrer"
                     data-analytics="social_click" data-platform={s.label.toLowerCase()}>
                    {s.label}
                  </a>
                </li>
              ))}
            </ul>
          </>
        )}
      </div>

      <div>
        <h2>{c.labels.branches}</h2>
        <ul class="footer-list">
          {branches.map((branch) => {
            const phone = primaryPhone(branch);
            return (
              <li>
                <a href={localePath(locale, `/locations/${branch.slug}`)}>
                  <strong>{L(branch.name, locale)}</strong>
                </a>
                <div style="color:#c3b7a7">
                  {L(branch.addressLine, locale)}, {L(branch.township, locale)}, {L(branch.city, locale)}
                </div>
                {phone && <a href={`tel:${phone.e164}`} data-analytics="phone_click"
                   data-branch={branch.slug} data-source="footer">{phone.display}</a>}
              </li>
            );
          })}
        </ul>
      </div>

      <div>
        <h2>{c.a11y.mainNav}</h2>
        {/* Every route appears here, which is what keeps the whole site
            reachable with JavaScript disabled (NAV-05). */}
        <ul class="footer-list">
          <li><a href={localePath(locale, '/')}>{c.nav.home}</a></li>
          {navItems(locale).map((item) => (
            <li><a href={localePath(locale, item.route)}>{item.label}</a></li>
          ))}
          <li><a href={localePath(locale, '/order')}>{c.nav.order}</a></li>
          <li><a href={localePath(locale, '/legal/privacy')}>{c.footer.privacy}</a></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {year} {SITE.brand.legal}. {c.footer.rights}</span>
      <a href={localePath(other, route)} lang={other} hreflang={other} rel="alternate">
        {LOCALE_LABEL[other]}
      </a>
    </div>
  </div>
</footer>
