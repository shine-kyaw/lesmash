---
import { existsSync } from 'node:fs';
import Wordmark from './Wordmark.astro';
import { asset } from '../lib/href';

/**
 * The opening screen.
 *
 * The brief asks for a site that reads as a gallery rather than a restaurant
 * page, and this is where that gets decided — one full viewport of the brand
 * with nothing competing.
 *
 * A still carries it today: the room in the evening, graded, with the lockup
 * over it. That is a finished screen, not a gap. A film is still the better
 * answer and the frame is already the right shape for one — drop `hero.mp4`
 * (plus a matching `hero-poster.jpg`) into public/media and it layers over the
 * still on the next build with nothing else to change.
 *
 * No note names the drop-in on the page. A visitor should never be told what a
 * page is missing; the file contract lives in public/media/README.md.
 */
const onDisk = (name: string) =>
  existsSync(new URL(`../../public/media/${name}`, import.meta.url));

const hasFilm = onDisk('hero.mp4');
const hasPoster = onDisk('hero-poster.jpg');
const hasStill = onDisk('hero-still.jpg');
---
<section class="film brand-red" aria-label="Le SMASH">
  {hasStill && (
    <img
      class="film__still"
      src={asset('/media/hero-still.jpg')}
      alt=""
      width="1920" height="1080"
      fetchpriority="high" decoding="async"
    />
  )}
  {hasFilm && (
    <video
      class="film__video"
      src={asset('/media/hero.mp4')}
      poster={hasPoster ? asset('/media/hero-poster.jpg') : undefined}
      autoplay muted loop playsinline preload="metadata"
      aria-hidden="true"
    ></video>
  )}
  <div class="film__grade" aria-hidden="true"></div>
  <div class="grain" aria-hidden="true"></div>

  <div class="wrap film__inner">
    <h1 class="visually-hidden">Le SMASH Burgers &amp; Co. — Yangon</h1>
    <div data-smash-word style="transform-origin:50% 100%">
      <Wordmark size="hero" link={false} />
    </div>
    <p class="film__tag script">Officially the best burger in town.</p>
  </div>

  <a class="film__scroll" href="#home" aria-label="Skip to the page">
    <span aria-hidden="true"></span>
  </a>
</section>
