---
import { SITE, absoluteUrl } from '../lib/site.config.mjs';

interface Props {
  path: string;
  title: string;
  description: string;
  noindex?: boolean;
  schema?: unknown[];
}
const { path, title, description, noindex = false, schema = [] } = Astro.props;
const canonical = absoluteUrl(path);
const jsonLd = schema.length ? { '@context': 'https://schema.org', '@graph': schema } : null;
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE.brand.legal} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content="en_US" />
<meta name="twitter:card" content="summary_large_image" />

<meta name="theme-color" content="#0a0a0c" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />

{/* The display face carries the hero, which is the LCP element. */}
<link rel="preload" href="/fonts/bodoni-moda-latin.woff2" as="font" type="font/woff2" crossorigin />

{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
