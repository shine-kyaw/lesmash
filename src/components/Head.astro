---
import { SITE, absoluteUrl } from '../lib/site.config.mjs';
import { asset } from '../lib/href';

/*
 * The three faces are declared here rather than in the stylesheet because a
 * base path (GitHub Pages serves from /lesmash/) cannot be interpolated into a
 * static CSS file. Latin subsets, self-hosted — no third-party origin sits on
 * the critical path, and the deployed CSP is font-src 'self'.
 *
 * Gasoek One and Grand Hotel are here because they are the closest available
 * matches to the two hands in the real logo; see src/styles/tokens.css. They
 * replaced Bodoni Moda, which was a stand-in chosen before any brand asset had
 * been recovered. 89KB total, against a 150KB per-page font budget.
 */
const faces = [
  { family: 'Gasoek One', file: 'gasoek-one-latin.woff2', weight: '400' },
  { family: 'Grand Hotel', file: 'grand-hotel-latin.woff2', weight: '400' },
  { family: 'Archivo', file: 'archivo-latin.woff2', weight: '100 900' },
  { family: 'IBM Plex Mono', file: 'plex-mono-latin.woff2', weight: '400 600' },
];
const LATIN =
  'U+0000-00FF, U+0131, U+0152-0153, U+2000-206F, U+2122, U+2212, U+FEFF, U+FFFD';
const fontCss = faces
  .map(
    (f) => `@font-face{font-family:'${f.family}';src:url('${asset('/fonts/' + f.file)}') format('woff2');font-weight:${f.weight};font-style:normal;font-display:swap;unicode-range:${LATIN};}`
  )
  .join('');

interface Props {
  path: string;
  title: string;
  description: string;
  noindex?: boolean;
  schema?: unknown[];
}
const { path, title, description, noindex = false, schema = [] } = Astro.props;
const canonical = absoluteUrl(path);
const ogImage = absoluteUrl('/og.jpg');
const jsonLd = schema.length ? { '@context': 'https://schema.org', '@graph': schema } : null;
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
{noindex && <meta name="robots" content="noindex, follow" />}

<meta property="og:type" content="website" />
<meta property="og:site_name" content={SITE.brand.legal} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:locale" content="en_US" />
<meta property="og:image" content={ogImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="The Le SMASH wordmark over a smash burger" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content={ogImage} />

{/* The brand red, so the phone's browser chrome joins the header bar. */}
<meta name="theme-color" content="#d83536" />
<link rel="icon" href={asset('/favicon-32.png')} type="image/png" sizes="32x32" />
<link rel="apple-touch-icon" href={asset('/apple-touch-icon.png')} />

<style set:html={fontCss}></style>

{/* The display face carries the hero, which is the LCP element. */}
<link rel="preload" href={asset('/fonts/gasoek-one-latin.woff2')} as="font" type="font/woff2" crossorigin />

{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
