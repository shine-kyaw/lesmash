---
import Wordmark from './Wordmark.astro';
import { COPY } from '../data/copy';
import { href } from '../lib/href';

/**
 * A solid red bar carrying the cream lockup, fixed at the top of every page.
 *
 * It used to be transparent over the hero and fill in on scroll, which existed
 * to keep a hero film unframed. There is no film, the hero is now the brand's
 * own red field, and a logo that has to work on both paper and red would need
 * two versions of the artwork. One red bar solves all of it.
 */
interface Props { path: string }
const { path } = Astro.props;

const links = [
  { href: '/menu', label: COPY.nav.menu },
  { href: '/#story', label: COPY.nav.story },
  { href: '/#visit', label: COPY.nav.visit },
];
---
<header class="hdr" data-header>
  <div class="wrap hdr__inner">
    <Wordmark size="bar" />

    <nav class="hdr__nav" aria-label="Main">
      {links.map((l) => (
        <a class="tlink" href={href(l.href)} aria-current={path === l.href ? 'page' : undefined}>
          {l.label}
        </a>
      ))}
    </nav>

    <a
      class="btn btn--cream hdr__cta"
      href={href("/menu")}
      data-analytics="order_cta_click"
      data-source="header"
    >{COPY.cta.orderShort}</a>
  </div>
</header>
