---
import Wordmark from './Wordmark.astro';
import { href } from '../lib/href';
import { COPY } from '../data/copy';

/**
 * Wordmark left, navigation centred, nothing on the right.
 *
 * Five links, matching the sitemap on the client's own foundation slide. There
 * is no order button: the brief is explicit that this is a portfolio and an
 * expression of the brand, not an ordering site.
 *
 * Their slide lists eight items. Collaborations lives inside Gallery and
 * Franchise inside Visit, because both are one block of content each and a
 * top-level page per block would make the navigation longer than the site.
 * Merch is not built — see docs/DECISIONS.md §12.
 *
 * The bar stays in the dark register at every scroll position, which is what
 * lets the cream lockup be the only version of the logo the site needs.
 */
interface Props { path: string }
const { path } = Astro.props;

const links = [
  { href: '/', label: COPY.nav.home },
  { href: '/#story', label: COPY.nav.story },
  { href: '/menu', label: COPY.nav.menu },
  { href: '/gallery', label: COPY.nav.gallery },
  { href: '/visit', label: COPY.nav.visit },
];
---
<header class="hdr dark" data-header>
  <div class="wrap hdr__inner">
    <Wordmark size="bar" />

    <nav class="hdr__nav" aria-label="Main">
      {links.map((l) => (
        <a class="tlink" href={href(l.href)} aria-current={path === l.href ? 'page' : undefined}>
          {l.label}
        </a>
      ))}
    </nav>

    <span class="hdr__spacer" aria-hidden="true"></span>
  </div>
</header>
