---
import { href } from '../lib/href';
import { COPY } from '../data/copy';

/**
 * Wordmark left, navigation centred, nothing on the right.
 *
 * Two links only. There is no order button: delivery runs through Foodpanda,
 * and the site's job is to tell people what is on the menu and where to find
 * it, not to run a checkout.
 */
interface Props { path: string }
const { path } = Astro.props;

const links = [
  { href: '/', label: COPY.nav.home },
  { href: '/menu', label: COPY.nav.menu },
];
---
<header class="hdr dark" data-header>
  <div class="wrap hdr__inner">
    <a class="mark" href={href('/')}><i>Le</i><b>SMASH</b></a>

    <nav class="hdr__nav" aria-label="Main">
      {links.map((l) => (
        <a class="tlink" href={href(l.href)} aria-current={path === l.href ? 'page' : undefined}>
          {l.label}
        </a>
      ))}
    </nav>

    <span class="hdr__spacer" aria-hidden="true"></span>
  </div>
</header>
