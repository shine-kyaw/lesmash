---
import { COPY } from '../data/copy';
import { href } from '../lib/href';

/**
 * Fixed and transparent over the hero, filling in only once the reader has
 * left it — the film is never framed by a bar on first paint. The fill is
 * applied by script; without script it simply stays transparent, which is
 * legible either way because the page ground is dark.
 */
interface Props { path: string }
const { path } = Astro.props;

const links = [
  { href: '/menu', label: COPY.nav.menu },
  { href: '/#story', label: COPY.nav.story },
  { href: '/#visit', label: COPY.nav.visit },
];
---
<header class="hdr" data-header>
  <div class="wrap hdr__inner">
    <a class="mark" href={href("/")} aria-label={`${'Le SMASH'} home`}>
      <i>Le</i><b>SMASH</b>
    </a>

    <nav class="hdr__nav" aria-label="Main">
      {links.map((l) => (
        <a class="tlink" href={href(l.href)} aria-current={path === l.href ? 'page' : undefined}>
          {l.label}
        </a>
      ))}
    </nav>

    <a
      class="btn btn--ember hdr__cta"
      href={href("/menu")}
      data-analytics="order_cta_click"
      data-source="header"
    >{COPY.cta.orderShort}</a>
  </div>
</header>
