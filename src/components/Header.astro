---
import Wordmark from './Wordmark.astro';
import { href } from '../lib/href';
import { COPY } from '../data/copy';

/**
 * Wordmark left, navigation centred, nothing on the right.
 *
 * Eight links: the sitemap from Reyy's 4 Nov 2026 briefing, less Franchise,
 * which the client has parked for a later phase, plus Music Video (revision 01).
 *
 * The bar stays in the dark register at every scroll position, which is what
 * lets the cream lockup be the only version of the logo the site needs.
 *
 * Phones and small tablets: eight links do not fit a strip, so with script a
 * Menu button opens them full screen (revision 01). Without script the strip
 * scrolls sideways as before.
 */
interface Props { path: string }
const { path } = Astro.props;

const links = [
  { href: '/', label: COPY.nav.home },
  { href: '/story', label: COPY.nav.story },
  { href: '/menu', label: COPY.nav.menu },
  { href: '/gallery', label: COPY.nav.gallery },
  { href: '/collaborations', label: COPY.nav.collaborations },
  { href: '/music-video', label: COPY.nav.music },
  { href: '/merch', label: COPY.nav.merch },
  { href: '/visit', label: COPY.nav.visit },
];
---
<header class="hdr dark" data-header>
  <div class="wrap hdr__inner">
    <Wordmark size="bar" />

    <nav class="hdr__nav" id="site-nav" aria-label="Main">
      {links.map((l) => (
        <a class="tlink" href={href(l.href)} aria-current={path === l.href ? 'page' : undefined}>
          {l.label}
        </a>
      ))}
    </nav>

    <span class="hdr__spacer" aria-hidden="true"></span>

    <button type="button" class="hdr__toggle" data-nav-toggle aria-controls="site-nav" aria-expanded="false" hidden>
      <span class="hdr__toggle-bars" aria-hidden="true"><i></i><i></i></span>
      <span data-nav-label>Menu</span>
    </button>
  </div>
</header>
