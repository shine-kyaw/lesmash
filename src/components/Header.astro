---
import Wordmark from './Wordmark.astro';
import { href } from '../lib/href';
import { COPY } from '../data/copy';

/**
 * Wordmark left, navigation centred, nothing on the right.
 *
 * Seven links: the sitemap from Reyy's 4 Nov 2026 briefing, less Franchise,
 * which the client has parked for a later phase.
 *
 * The bar stays in the dark register at every scroll position, which is what
 * lets the cream lockup be the only version of the logo the site needs.
 */
interface Props { path: string }
const { path } = Astro.props;

const links = [
  { href: '/', label: COPY.nav.home },
  { href: '/story', label: COPY.nav.story },
  { href: '/menu', label: COPY.nav.menu },
  { href: '/gallery', label: COPY.nav.gallery },
  { href: '/collaborations', label: COPY.nav.collaborations },
  { href: '/merch', label: COPY.nav.merch },
  { href: '/visit', label: COPY.nav.visit },
];
---
<header class="hdr dark" data-header>
  <div class="wrap hdr__inner">
    <Wordmark size="bar" />

    <nav class="hdr__nav" aria-label="Main">
      {links.map((l) => (
        <a class="tlink" href={href(l.href)} aria-current={path === l.href ? 'page' : undefined}>
          {l.label}
        </a>
      ))}
    </nav>

    <span class="hdr__spacer" aria-hidden="true"></span>
  </div>
</header>
