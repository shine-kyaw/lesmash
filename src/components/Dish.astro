---
import { COPY } from '../data/copy';
import { formatPrice, limitedToBranches, IS_PREVIEW, type Branch, type MenuItem } from '../lib/content';
import Shot from './Shot.astro';

/**
 * A dish card: picture, name, price, and the portion facts.
 *
 * Patty count and portion sit on the card, never behind a tap. A customer must
 * be able to learn the size of what they are buying without opening anything —
 * that is the premise of this project.
 */
interface Props {
  item: MenuItem;
  branches: Branch[];
  soldOut?: boolean;
}
const { item, branches, soldOut = false } = Astro.props;

const price = formatPrice(item.price);
const limited = limitedToBranches(item, branches);
const unavailable = !item.isAvailable || soldOut;
---
<li
  class:list={['dish', { 'dish--out': unavailable }]}
  data-tags={item.tags.join(' ')}
>
  <div class="dish__media">
    {item.image ? (
      <img src={item.image.src} alt={item.image.alt} width="640" height="480"
           loading="lazy" decoding="async" />
    ) : (
      <Shot ratio="4x3" />
    )}
  </div>

  <div class="dish__body">
    <div class="dish__top">
      <h3 class="dish__name">{item.name}</h3>

      {item.priceDisplay ? (
        <span class="dish__price">{item.priceDisplay}</span>
      ) : price ? (
        <span class="dish__price">{price}</span>
      ) : (
        /* No price on this site has been confirmed by the restaurant, so we
           say so rather than printing a number nobody has stood behind. */
        <span class="dish__price dish__price--unset">{COPY.state.priceUnset}</span>
      )}
    </div>

    {item.description && <p class="dish__desc">{item.description}</p>}

    <div class="dish__meta">
      {unavailable && (
        <span class="fact fact--warn">{soldOut ? COPY.state.soldOut : COPY.state.unavailable}</span>
      )}
      {item.pattyCount && <span class="fact fact--hot">{COPY.labels.patty(item.pattyCount)}</span>}
      {item.portionNote && <span class="fact">{item.portionNote}</span>}
      {item.weightG && <span class="fact">{item.weightG}g</span>}
      {item.spiceLevel && item.spiceLevel !== 'none' && (
        /* Never colour or icon alone — the level is always spelled out. */
        <span class="fact">{COPY.labels.spice}: {COPY.spice[item.spiceLevel]}</span>
      )}
      {limited.map((b) => <span class="fact">{b.name} only</span>)}
      {IS_PREVIEW && !item.verified && (
        <span class="fact fact--warn" title={item.sourceNote ?? undefined}>{COPY.state.pending}</span>
      )}
    </div>
  </div>
</li>
