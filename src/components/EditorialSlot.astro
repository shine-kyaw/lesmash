---
import { IS_PREVIEW } from '../lib/content';
import { editorialText, type EditorialSlot } from '../data/editorial';
import type { Locale } from '../lib/i18n';

/**
 * Renders a piece of client-supplied editorial copy.
 *
 * If the client has supplied it, it renders normally. If not:
 *  - preview build → a visibly labelled placeholder naming the content-register
 *    reference and who owes it, so review meetings can act on it;
 *  - live build → nothing renders at all.
 *
 * What never happens is the agency writing a claim about the business to fill
 * the gap (PRD §17.1).
 */
interface Props {
  slot: EditorialSlot;
  locale: Locale;
  as?: 'p' | 'div';
  class?: string;
}
const { slot, locale, as: Tag = 'p', class: className = '' } = Astro.props;
const text = editorialText(slot, locale);
---
{text ? (
  <Tag class={className}>{text}</Tag>
) : IS_PREVIEW ? (
  <div class="slot">
    <span class="slot__ref">Content slot {slot.ref} · owner: {slot.owner.replace(/-/g, ' ')}</span>
    {slot.note}
  </div>
) : null}
