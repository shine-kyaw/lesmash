---
/**
 * The line-up: mugs, tote and cups, one at a time under a spotlight.
 *
 * Client revision 01 (21 Nov 2026) asked to drop the up/down swipe of the old
 * scroll-pinned 3D ring, for "a more balanced composition that feels intuitive
 * and easy to browse" with smoother transitions. So:
 * - One stage: the piece in front stands on a lit plinth, the light takes its
 *   colour, a reflection on the floor. Name, note and count beside it.
 * - A row of all five underneath to pick from. Arrows, keys and a sideways
 *   swipe on the stage step through them. The page always scrolls normally.
 * - Phones: stage on top, details and picker row below.
 * Without script every piece is still listed with its name and note.
 */
import { asset } from '../../lib/href';
import { LINEUP } from '../../data/merch';
const pad = (n: number) => String(n).padStart(2, '0');
---
<section class="mc-line dark" id="lineup" aria-labelledby="mc-line-h">
  <div class="wrap mc-sec-head mc-sec-head--dark">
    <h2 id="mc-line-h">Mugs, tote, cups</h2>
  </div>

  <div class="wrap mc-spot" data-spot style={`--glow:${LINEUP[0].glow}`}>
    <div class="mc-spot__stage" data-spot-stage tabindex="0" role="group" aria-roledescription="carousel"
         aria-label="Mugs, tote and cups. Use the arrow keys or swipe to change piece.">
      <span class="mc-spot__light" aria-hidden="true"></span>
      <span class="mc-spot__plinth" aria-hidden="true"></span>
      {LINEUP.map((it, i) => (
        <figure class="mc-spot__piece" data-spot-piece hidden={i > 0 ? true : undefined} style={`--ar:${it.w}/${it.h}`}>
          <img class="mc-spot__img" src={asset(it.src)} alt={it.alt} width={it.w} height={it.h}
               loading="lazy" decoding="async" draggable="false" />
          <img class="mc-spot__refl" src={asset(it.src)} alt="" aria-hidden="true" width={it.w} height={it.h}
               loading="lazy" decoding="async" draggable="false" />
        </figure>
      ))}
    </div>

    <div class="mc-spot__info">
      <p class="mc-spot__count label" aria-hidden="true"><b data-spot-n>01</b> / {pad(LINEUP.length)}</p>
      <div class="mc-spot__text" aria-live="polite">
        <h3 class="mc-spot__name" data-spot-name>{LINEUP[0].name}</h3>
        <p class="mc-spot__note" data-spot-note>{LINEUP[0].note}</p>
      </div>
      <div class="mc-spot__arrows">
        <button type="button" class="mc-nav" data-spot-prev aria-label="Previous piece">←</button>
        <button type="button" class="mc-nav" data-spot-next aria-label="Next piece">→</button>
      </div>
    </div>

    <ul class="mc-spot__picks" role="list" aria-label="Choose a piece">
      {LINEUP.map((it, i) => (
        <li>
          <button type="button" class="mc-pick" data-spot-pick={i} aria-pressed={i === 0 ? 'true' : 'false'}
                  aria-label={`${it.name}: ${it.note}`} data-name={it.name} data-note={it.note} data-glow={it.glow}>
            <img src={asset(it.src)} alt="" width={it.w} height={it.h} loading="lazy" decoding="async" draggable="false" />
          </button>
        </li>
      ))}
    </ul>
  </div>
</section>
