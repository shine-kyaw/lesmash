---
import { asset } from '../../lib/href';
import { LINEUP } from '../../data/merch';
---
<section class="mc-line dark" id="lineup" aria-labelledby="mc-line-h">
  <div class="wrap mc-sec-head mc-sec-head--dark">
    <p class="label mc-line__label">02 · The line-up</p>
    <h2 id="mc-line-h">Mugs, tote, cups</h2>
    <p class="lede">Move across them. Whichever one you stop on steps up into the light.</p>
  </div>

  <div class="mc-stage" data-stage>
    <div class="mc-spot" aria-hidden="true"></div>
    <ul class="mc-lu" data-lu role="list">
      {LINEUP.map((it, i) => (
        <li class="mc-lu-item" data-i={i}>
          <button type="button" class="mc-lu-btn" aria-label={`${it.name}. ${it.note}`}>
            <span class="mc-lu-in" data-in>
              <span class="mc-plate">
                <img src={asset(it.src)} alt={it.alt} loading="lazy" decoding="async" draggable="false"
                  style={`object-position:${it.pos};transform-origin:${it.pos};transform:scale(${it.zoom})`} />
              </span>
              <span class="mc-shadow" aria-hidden="true"></span>
            </span>
          </button>
        </li>
      ))}
    </ul>
    <p class="mc-lu-name" data-name aria-live="polite">
      <span class="mc-lu-name__n" data-name-n>{LINEUP[2].name}</span>
      <span class="mc-lu-name__d label" data-name-d>{LINEUP[2].note}</span>
    </p>
  </div>
  <script type="application/json" id="mc-lineup-data" set:html={JSON.stringify(LINEUP.map(({ name, note }) => ({ name, note })))}></script>
</section>
