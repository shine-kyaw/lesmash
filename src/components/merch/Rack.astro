---
import { asset } from '../../lib/href';
import { GARMENTS } from '../../data/merch';
---
<section class="mc-rack-sec" id="rack" aria-labelledby="mc-rack-h">
  <div class="wrap mc-sec-head">
    <h2 id="mc-rack-h">Take one off the rail</h2>
    <p class="lede">Click a piece to see it worn.</p>
  </div>

  <div class="mc-studio" data-studio>
    <div class="mc-scroll" data-scroll>
      <div class="mc-stage3d" data-stage3d>
        <div class="mc-row3d" data-row3d>
          <div class="mc-rail" aria-hidden="true"><i class="mc-rail__cap mc-rail__cap--l"></i><i class="mc-rail__cap mc-rail__cap--r"></i></div>
          <ul class="mc-row" role="list">
            {GARMENTS.map((g) => (
              <li class="mc-hang" style={`--gw:${(g.w / 700).toFixed(4)};--gh:${(g.h / 700).toFixed(4)};--ar:${g.w}/${g.h}`}>
                <span class="mc-wall" aria-hidden="true"></span>
                <span class="mc-pivot" data-pivot>
                    <span class="mc-spin" data-spin>
                      <img class="mc-face mc-edge" src={asset(g.front)} alt="" draggable="false" aria-hidden="true" style="transform:translateZ(-3px)" />
                      <img class="mc-face mc-edge" src={asset(g.front)} alt="" draggable="false" aria-hidden="true" style="transform:translateZ(-1px)" />
                      <img class="mc-face mc-edge" src={asset(g.front)} alt="" draggable="false" aria-hidden="true" style="transform:translateZ(1px)" />
                      <img class="mc-face mc-front" src={asset(g.front)} alt={g.rest === 'front' ? g.frontAlt : ''} loading="lazy" decoding="async" draggable="false" />
                      <img class="mc-face mc-back" src={asset(g.back)} alt={g.rest === 'back' ? g.backAlt : ''} loading="lazy" decoding="async" draggable="false" />
                    </span>
                  </span>
                <button type="button" class="mc-hang-btn" data-garment={g.id} aria-haspopup="dialog"
                  aria-label={`${g.name}, ${g.tag}. Open details`}>
                  <span class="mc-cap">
                    <span class="mc-cap__name">{g.name}</span>
                    <span class="mc-cap__tag label">{g.tag}</span>
                  </span>
                </button>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
