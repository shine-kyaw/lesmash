---
import { GARMENTS } from '../../data/merch';
import { asset } from '../../lib/href';
const data = GARMENTS.map((g) => ({ ...g, front: asset(g.front), back: asset(g.back), worn: g.worn.map((v) => ({ ...v, src: asset(v.src) })) }));
---
<dialog class="mc-detail" id="mc-detail" aria-labelledby="mc-d-name">
  <div class="mc-d-panel" data-panel>
    <button type="button" class="mc-d-close" data-close aria-label="Close and hang it back up">
      <span aria-hidden="true">✕</span> <span class="mc-d-close__t">Rehang</span>
    </button>
    <div class="mc-d-fig" data-fig>
      <div class="mc-d-stage" data-stage>
        <div class="mc-d-3d" data-3d>
          <div class="mc-d-spin" data-dspin>
            <img class="mc-face mc-edge" data-e src="" alt="" draggable="false" aria-hidden="true" style="transform:translateZ(-4px)" />
            <img class="mc-face mc-edge" data-e src="" alt="" draggable="false" aria-hidden="true" style="transform:translateZ(-1.5px)" />
            <img class="mc-face mc-edge" data-e src="" alt="" draggable="false" aria-hidden="true" style="transform:translateZ(1.5px)" />
            <img class="mc-face mc-front" data-f src="" alt="" draggable="false" />
            <img class="mc-face mc-back" data-b src="" alt="" draggable="false" />
          </div>
          <span class="mc-d-floor" aria-hidden="true"></span>
        </div>
        <div class="mc-d-worn" data-worn aria-hidden="true"><img data-wimg src="" alt="" draggable="false" /></div>
      </div>
      <p class="mc-d-hint label" aria-hidden="true">Drag to turn it</p>
    </div>
    <div class="mc-d-copy" data-copy>
      <p class="label label--ember" data-d-tag></p>
      <h2 id="mc-d-name" data-d-name></h2>
      <p class="mc-d-note" data-d-note></p>
      <div class="mc-d-actions">
        <button type="button" class="btn btn--ghost mc-d-worn-btn" data-worn-toggle aria-pressed="false">See it worn</button>
        <div class="mc-d-views" data-d-views role="group" aria-label="Worn view" hidden></div>
      </div>
    </div>
  </div>
</dialog>
<script type="application/json" id="mc-garment-data" set:html={JSON.stringify(data)}></script>
