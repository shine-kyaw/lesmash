---
import { asset } from '../../lib/href';
---
<header class="mc-head" id="mc-head">
  <img class="mc-head__pattern" src={asset('/brand/pattern-monogram.png')} alt="" aria-hidden="true" width="600" height="600" decoding="async" />
  <div class="wrap mc-head__in">
    <p class="mc-head__kicker label">Le SMASH · Merch</p>
    <h1 class="mc-h1" aria-label="Wear the SMASH">
      <span class="mc-h1__line" aria-hidden="true"><span>Wear</span></span>
      <span class="mc-h1__line" aria-hidden="true"><span><i class="script">the</i> SMASH</span></span>
    </h1>
    <p class="mc-head__lede">Tees on the rack. A jersey. A tote, mugs and cups on the stage. Have a look round, then come and see us.</p>
    <p class="mc-head__tape" aria-hidden="true"><span>Tees</span><span>Jersey</span><span>Tote</span><span>Mugs</span><span>Cups</span></p>
  </div>
  <img class="mc-stk mc-stk--a" src={asset('/brand/sticker-beef.png')} alt="" aria-hidden="true" width="300" height="300" />
  <img class="mc-stk mc-stk--b" src={asset('/brand/sticker-fish.png')} alt="" aria-hidden="true" width="300" height="300" />
  <img class="mc-stk mc-stk--c" src={asset('/brand/sticker-lecoq.png')} alt="" aria-hidden="true" width="300" height="300" />
</header>
