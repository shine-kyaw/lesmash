---
/**
 * Meet the crew. Ten square photos in a normal grid. Click one and the grid
 * flies onto a slowly swaying ring around a profile card (phones: a full-width
 * profile sheet with a swipeable strip). No pinning, no scroll hijack.
 *
 * The profile is a deliberate template: Name / Position / In their words stay as
 * ruled blanks until src/data/team.ts has the real text, then the text replaces
 * the rules. atWork / dish fill the two dashed frames the same way.
 */
import { asset } from '../../lib/href';
import { TEAM } from '../../data/team';
import manifest from '../../data/media-manifest.json';

const dims = manifest as { path: string; width: number; height: number }[];
const members = TEAM.map((m, i) => {
  const d = dims.find((x) => x.path === m.photo);
  return { ...m, src: asset(m.photo), w: d?.width ?? 1080, h: d?.height ?? 1080, i };
});
const N = members.length;
const SIG = 'M4 30 C 26 4, 44 6, 58 24 S 92 40, 118 20 S 160 2, 186 22 S 236 38, 262 16 S 290 10, 296 14';
---
<section class="vs-team" id="team" aria-labelledby="vs-team-h">
  <div class="wrap">
    <header class="vs-team__head">
      <p class="label label--ember">The crew</p>
      <h2 id="vs-team-h">Meet our <span class="script">team</span></h2>
      <p class="lede">
        Every smash you've ever liked went through these hands. Different personalities,
        one shared love for smashing burgers.
      </p>
    </header>

    <div class="vs-tm" data-tm data-state="grid">
      <div class="vs-tm__stage" data-stage>
        <ul class="vs-tm__grid" data-grid>
          {members.map((m) => (
            <li>
              <button type="button" class="vs-tile" data-tile={m.i}
                data-src={m.src} data-alt={m.alt} data-w={m.w} data-h={m.h}
                data-name={m.name ?? ''} data-role={m.role ?? ''} data-quote={m.quote ?? ''}
                data-atwork={m.atWork ? asset(m.atWork) : ''} data-dish={m.dish ? asset(m.dish) : ''}
                aria-label={`Open crew member ${m.i + 1} of ${N}`}>
                <img src={m.src} alt={m.alt} width={m.w} height={m.h} loading="lazy" decoding="async" />
              </button>
            </li>
          ))}
        </ul>

        <div class="vs-pn" data-panel>
          <div class="vs-pn__top">
            <button type="button" class="vs-pn__back" data-back>
              <span aria-hidden="true">&larr;</span> Back to the grid
            </button>
            <p class="vs-pn__count" aria-live="polite"><b data-cur>01</b> / {String(N).padStart(2, '0')}</p>
          </div>

          <div class="vs-pn__main">
            <figure class="vs-pn__photo" data-pphoto>
              <img data-pimg alt="" width="1080" height="1080" decoding="async" />
              <img data-pimg alt="" width="1080" height="1080" decoding="async" />
            </figure>

            <div class="vs-pn__body">
              <div class="vs-pn__row" data-row="name" data-empty="1">
                <span class="vs-pn__lab">Name</span>
                <div class="vs-pn__val"><h3 class="vs-pn__txt vs-pn__txt--name" data-txt></h3><i class="vs-pn__rule vs-pn__rule--name" data-rule></i></div>
              </div>
              <div class="vs-pn__row" data-row="role" data-empty="1">
                <span class="vs-pn__lab">Position</span>
                <div class="vs-pn__val"><p class="vs-pn__txt vs-pn__txt--role" data-txt></p><i class="vs-pn__rule" data-rule></i></div>
              </div>
              <div class="vs-pn__qrow">
                <div class="vs-pn__row vs-pn__row--quote" data-row="quote" data-empty="1">
                  <span class="vs-pn__lab">In their words</span>
                  <div class="vs-pn__val"><p class="vs-pn__txt vs-pn__txt--quote" data-txt></p><span class="vs-pn__rule vs-pn__rule--lines" data-rule aria-hidden="true"><i></i><i></i><i></i></span></div>
                </div>
                <svg class="vs-pn__sig" viewBox="0 0 300 44" preserveAspectRatio="none" aria-hidden="true" focusable="false">
                  <line class="vs-pn__base" x1="2" y1="40" x2="298" y2="40" />
                  <path class="vs-pn__stroke" data-sig d={SIG} pathLength="1" />
                </svg>
              </div>
            </div>
          </div>

          <div class="vs-pn__slots">
            <div class="vs-pn__frame" data-frame="atwork"><span class="vs-pn__flab">At work</span><img alt="" hidden /></div>
            <div class="vs-pn__frame" data-frame="dish"><span class="vs-pn__flab">Signature dish</span><img alt="" hidden /></div>
          </div>

          <ul class="vs-pn__strip" data-strip>
            {members.map((m) => (
              <li>
                <button type="button" data-go={m.i} aria-label={`Show crew member ${m.i + 1} of ${N}`}>
                  <img src={m.src} alt="" width={m.w} height={m.h} loading="lazy" decoding="async" />
                </button>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import './team-showcase.ts';
</script>
