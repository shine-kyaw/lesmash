---
import { t } from '../data/copy';
import { L, type Branch } from '../lib/content';
import type { Locale } from '../lib/i18n';
import OpenState from './OpenState.astro';

/**
 * Branch chooser (ORD-02).
 *
 * Rendered as a <dialog> that the sticky Order button opens. The identical
 * markup is also served as a real page at /order, so a customer whose script
 * failed still reaches the same two links — ordering never depends on JS.
 */
interface Props {
  locale: Locale;
  branches: Branch[];
  /** `dialog` for the global overlay, `inline` for the /order page body. */
  variant?: 'dialog' | 'inline';
}
const { locale, branches, variant = 'dialog' } = Astro.props;
const c = t(locale);
const orderable = branches.filter((b) => b.foodpandaUrl);

const List = () => null;
---
{variant === 'dialog' ? (
  <dialog class="chooser" id="branch-chooser" aria-labelledby="branch-chooser-title">
    <div class="chooser__head">
      <div>
        <h2 id="branch-chooser-title" style="font-size:var(--step-2)">{c.cta.chooseBranch}</h2>
        <p class="meta" style="margin-top:.25rem">{c.cta.chooseBranchHint}</p>
      </div>
      <button class="drawer-toggle" type="button" data-chooser-close>
        <span class="visually-hidden">{c.labels.closeMenu}</span>
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
    <ul class="chooser__list">
      {orderable.map((branch) => (
        <li>
          <a
            class="chooser__option"
            href={branch.foodpandaUrl!}
            target="_blank"
            rel="noopener noreferrer"
            data-analytics="foodpanda_outbound"
            data-branch={branch.slug}
            data-source="chooser"
            data-remember-branch={branch.slug}
          >
            <span>
              <strong>{L(branch.name, locale)}</strong>
              <span class="meta" style="display:block">{L(branch.township, locale)}</span>
            </span>
            <OpenState hours={branch.openingHours} locale={locale} />
          </a>
        </li>
      ))}
    </ul>
  </dialog>
) : (
  <ul class="chooser__list">
    {orderable.map((branch) => (
      <li>
        <a
          class="chooser__option"
          href={branch.foodpandaUrl!}
          target="_blank"
          rel="noopener noreferrer"
          data-analytics="foodpanda_outbound"
          data-branch={branch.slug}
          data-source="order_page"
          data-remember-branch={branch.slug}
        >
          <span>
            <strong>{L(branch.name, locale)}</strong>
            <span class="meta" style="display:block">{L(branch.township, locale)}</span>
          </span>
          <OpenState hours={branch.openingHours} locale={locale} />
        </a>
      </li>
    ))}
  </ul>
)}
