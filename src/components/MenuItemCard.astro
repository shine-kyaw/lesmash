---
import { t } from '../data/copy';
import { L, formatPrice, limitedToBranches, IS_PREVIEW, type Branch, type MenuItem } from '../lib/content';
import type { Locale } from '../lib/i18n';
import Placeholder from './Placeholder.astro';

/**
 * The menu item card.
 *
 * This component is where the project's central idea lives. Price, patty count
 * and portion note render in the LIST view, never behind a tap — a customer
 * must never have to open a detail view to learn the size of what they are
 * buying (PRD §5.1, MENU-02/03/04).
 *
 * Two rules it enforces structurally:
 *  - A fact is rendered only when it is set. An unset portion is simply absent;
 *    it is never padded out with a plausible-sounding value.
 *  - An unavailable item is dimmed and labelled, never hidden (MENU-09).
 *    Hiding shrinks the apparent menu; labelling manages the expectation.
 */
interface Props {
  item: MenuItem;
  locale: Locale;
  branches: Branch[];
  /** Sold-out today at the branch currently in context. */
  soldOut?: boolean;
}
const { item, locale, branches, soldOut = false } = Astro.props;
const c = t(locale);

const name = L(item.name, locale);
const description = L(item.description, locale);
const priceText = formatPrice(item.price);
const priceOverride = L(item.priceDisplay, locale);
const portion = L(item.portionNote, locale);
const combo = L(item.comboContents, locale);
const limited = limitedToBranches(item, branches);
const unavailable = !item.isAvailable || soldOut;

const hasDetails = Boolean(
  description || combo || item.allergens.length || item.dietary.length || item.weightG
);
---
<li class="card item" class:list={{ 'item--unavailable': unavailable }} data-item={item.slug}
    data-tags={item.tags.join(' ')}
    data-spice={item.spiceLevel ?? ''}
    data-dietary={item.dietary.join(' ')}
    data-branches={item.branchAvailability.join(' ')}>
  <div class="item__media">
    {item.image ? (
      <img src={item.image.src} alt={L(item.image.alt, locale) ?? ''} width="480" height="360"
           loading="lazy" decoding="async" />
    ) : (
      <Placeholder ratio="4x3" label={c.state.noPhoto} />
    )}
  </div>

  <div class="item__body">
    <div class="item__top">
      <h3 class="item__name">{name}</h3>
      {priceOverride ? (
        <span class="item__price">{priceOverride}</span>
      ) : priceText ? (
        <span class="item__price">{priceText}</span>
      ) : (
        /* No confirmed price yet. We say so plainly rather than printing a
           number nobody has stood behind (MENU-02, DS-04). */
        <span class="item__price item__price--unset">{c.state.priceOnRequest}</span>
      )}
    </div>

    {description && <p class="item__desc">{description}</p>}

    <div class="item__facts badge-row">
      {unavailable && (
        <span class="badge badge--warn">
          {soldOut ? c.state.soldOutToday : c.state.unavailable}
        </span>
      )}
      {item.pattyCount && <span class="badge">{c.labels.patty(item.pattyCount)}</span>}
      {portion && <span class="badge">{portion}</span>}
      {item.spiceLevel && item.spiceLevel !== 'none' && (
        /* Never icon-only and never colour-only — the level is always spelled
           out in text (MENU-11, A11Y-03). */
        <span class="badge">{c.labels.spice}: {c.spice[item.spiceLevel]}</span>
      )}
      {item.tags.includes('popular') && <span class="badge badge--accent">{c.tags.popular}</span>}
      {limited.map((b) => (
        <span class="badge">{c.state.branchOnly(L(b.name, locale) ?? b.slug)}</span>
      ))}
      {IS_PREVIEW && !item.verified && (
        <span class="badge badge--warn" title={item.sourceNote ?? undefined}>
          {c.state.contentPending}
        </span>
      )}
    </div>

    {hasDetails && (
      /* An in-page expansion, not a separate URL: 29 items across two locales
         would otherwise become dozens of thin, duplicated pages (PRD §11.3).
         <details> costs no JavaScript and shifts nothing around it. */
      <details class="item__details">
        <summary>{c.a11y.itemDetails}</summary>
        <dl>
          {combo && (<><dt>{c.labels.includes}</dt><dd>{combo}</dd></>)}
          {item.weightG && (<><dt>{c.labels.weight}</dt><dd>{item.weightG}g</dd></>)}
          {item.dietary.length > 0 && (
            <><dt>{c.labels.dietary}</dt>
              <dd>{item.dietary.map((d) => c.dietary[d]).join(', ')}</dd></>
          )}
          {item.allergens.length > 0 && (
            <><dt>{c.labels.allergens}</dt><dd>{item.allergens.join(', ')}</dd></>
          )}
        </dl>
      </details>
    )}
  </div>
</li>
