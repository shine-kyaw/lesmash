---
import { COLLABS } from '../../data/collabs';
import { asset } from '../../lib/href';

const facts = (c: (typeof COLLABS)[number]) =>
  [c.partner + ': ' + c.title, c.date, c.place].filter(Boolean).join(', ');

/* The ribbon runs all the way round a cylinder, so the set is laid twice.
   The second set is a visual repeat only: hidden from assistive tech and the tab order. */
const cards = [
  ...COLLABS.map((c, i) => ({ c, i, clone: false })),
  ...COLLABS.map((c, i) => ({ c, i, clone: true })),
];
---
<section class="cb-wallsec dark" id="wall" aria-labelledby="cb-wall-h" data-cb-wallsec>
  <div class="wrap cb-wallsec__head">
    <h2 class="cb-wallsec__h" id="cb-wall-h">The wall</h2>
    <p class="cb-wallsec__hint">
      <span class="cb-hint-mouse">Drag the band. Click a poster.</span>
      <span class="cb-hint-touch">Swipe the band. Tap a poster.</span>
    </p>
  </div>

  <div class="cb-stage" data-cb-stage>
    <ul class="cb-band" data-cb-band>
      {cards.map(({ c, i, clone }) => (
        <li class={`cb-card${clone ? ' cb-card--clone' : ''}`} data-cb-card data-i={i}
            data-w={c.poster.w} data-h={c.poster.h} data-name={c.partner} data-date={c.date ?? ''}
            aria-hidden={clone ? 'true' : undefined}>
          <button type="button" class="cb-poster" data-cb-open={c.id} aria-haspopup="dialog" tabindex={clone ? -1 : undefined}>
            <img src={asset(c.poster.src)} alt={clone ? '' : c.poster.alt} width={c.poster.w} height={c.poster.h}
                 loading="lazy" decoding="async" draggable="false" />
            <span class="cb-poster__shade" aria-hidden="true"></span>
            {!clone && <span class="visually-hidden">{facts(c)}. Open details.</span>}
          </button>
        </li>
      ))}
    </ul>
    <p class="cb-stage__cap" aria-hidden="true" data-cb-cap></p>
  </div>
</section>
