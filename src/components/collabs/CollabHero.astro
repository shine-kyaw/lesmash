---
import { COLLABS } from '../../data/collabs';
import { asset } from '../../lib/href';

const names = COLLABS.map((c) => c.partner).join(', ');
---
<section class="cb-hero dark" data-cb-hero aria-labelledby="cb-h1">
  <div class="wrap cb-hero__inner">
    <div class="cb-hero__head">
      <h1 class="cb-hero__title" id="cb-h1">
        <span class="visually-hidden">Le SMASH × {names}</span>
        <span class="cb-hero__stack" aria-hidden="true" data-cb-line>
          <span class="cb-hero__le">Le</span>
          <span class="cb-hero__smash">SMASH</span>
          <span class="cb-hero__x">×</span>
        </span>
      </h1>
      <p class="lede cb-hero__lede">
        Other Yangon brands, venues and artists. The nights, pop-ups and projects we made together.
      </p>
    </div>

    <ul class="cb-bill" aria-label="Collaborations" data-cb-bill>
      {COLLABS.map((c) => (
        <li class="cb-row" data-cb-row>
          <button type="button" class="cb-row__btn" data-cb-open={c.id} aria-haspopup="dialog"
                  data-poster={asset(c.poster.src)} data-w={c.poster.w} data-h={c.poster.h} data-alt={c.poster.alt}>
            <span class="cb-row__name">{c.partner}</span>
            <span class="cb-row__meta">
              {c.date && <span>{c.date}</span>}
              {c.place && <span>{c.place}</span>}
            </span>
            <img class="cb-row__thumb" src={asset(c.poster.src)} alt="" width={c.poster.w} height={c.poster.h}
                 loading="lazy" decoding="async" />
            <span class="visually-hidden">{c.title}. Open details.</span>
          </button>
        </li>
      ))}
    </ul>
  </div>

  <div class="cb-float" data-cb-float aria-hidden="true"><img src="" alt="" decoding="async" /></div>
</section>
