---
import { COLLABS } from '../../data/collabs';
import { asset } from '../../lib/href';

const data = COLLABS.map((c) => ({
  ...c,
  poster: { ...c.poster, src: asset(c.poster.src) },
  photos: c.photos.map((p) => ({ ...p, src: asset(p.src) })),
}));
---
<dialog class="cb-dlg" data-cb-dlg aria-labelledby="cb-dlg-h">
  <div class="cb-dlg__inner">
    <button type="button" class="cb-dlg__x" data-cb-close aria-label="Close">×</button>
    <div class="cb-dlg__media">
      <div class="cb-dlg__stage"><img data-cb-main src="" alt="" /></div>
      <ul class="cb-dlg__strip" data-cb-strip aria-label="More from this collab"></ul>
    </div>
    <div class="cb-dlg__info" data-cb-info>
      <p class="label cb-dlg__kicker" data-cb-kicker></p>
      <h2 class="cb-dlg__h" id="cb-dlg-h" data-cb-name></h2>
      <p class="cb-dlg__title" data-cb-title></p>
      <p class="cb-dlg__blurb" data-cb-blurb></p>
      <dl class="cb-dlg__facts" data-cb-facts></dl>
      <div class="cb-dlg__nav">
        <button type="button" class="btn btn--ghost" data-cb-prev>← Prev</button>
        <button type="button" class="btn btn--ghost" data-cb-next>Next →</button>
      </div>
    </div>
  </div>
</dialog>
<script id="cb-data" type="application/json" set:html={JSON.stringify(data)} />
