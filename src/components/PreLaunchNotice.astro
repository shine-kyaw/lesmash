---
import { IS_PREVIEW } from '../lib/content';
import type { Locale } from '../lib/i18n';

/**
 * Standing pre-launch notice, rendered only in preview builds.
 *
 * The site is structurally complete but its content is not yet confirmed by the
 * client. Rather than let placeholder records be mistaken for published fact,
 * the site says so on every page. Setting CONTENT_MODE=live removes this and,
 * at the same time, stops unverified records rendering at all.
 */
interface Props { locale: Locale }
const { locale } = Astro.props;

const text = {
  en: {
    label: 'Preview build —',
    body: 'menu names, prices, hours and phone numbers are not yet confirmed.',
    more: 'Nothing on this site should be relied on until the restaurant signs it off.',
  },
  my: {
    label: 'ကြိုတင်ကြည့်ရှုရန် ဗားရှင်း —',
    body: 'မီနူးအမည်၊ ဈေးနှုန်း၊ ဖွင့်ချိန်နှင့် ဖုန်းနံပါတ်များကို အတည်မပြုရသေးပါ။',
    more: 'ဆိုင်မှ အတည်ပြုပြီးမှသာ အားကိုးအားထားပြုနိုင်ပါမည်။',
  },
}[locale];
---
{IS_PREVIEW && (
  <div class="prelaunch">
    <div class="container">
      {/* Kept to a single line on mobile: this is a review aid, and it must not
          eat the first screen the homepage is judged on (HOME-01). */}
      <p>
        <strong>{text.label}</strong>{' '}{text.body}
        <span class="prelaunch__more">{' '}{text.more}</span>
      </p>
    </div>
  </div>
)}
