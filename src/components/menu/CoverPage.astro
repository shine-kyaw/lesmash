---
import { asset } from '../../lib/href';
---
<div class="mn-cover">
  <img class="mn-cover__pattern" src={asset('/brand/pattern-monogram.png')} alt="" width="900" height="898" loading="eager" />
  <img class="mn-cover__logo" src={asset('/brand/logo-lockup-cream.png')} alt="Le SMASH Burgers & Co." width="760" height="451" loading="eager" />
  <p class="mn-cover__menu">Menu</p>
  <img class="mn-cover__stk mn-cover__stk--a" src={asset('/brand/sticker-beef.png')} alt="" width="320" height="320" loading="eager" />
  <p class="mn-cover__flip" aria-hidden="true">
    <span class="mn-cover__flip-d">Flip the page</span><span class="mn-cover__flip-m">Swipe to flip</span>
    <svg viewBox="0 0 40 16" width="40" height="16"><path d="M1 8h36M30 1l7 7-7 7" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg>
  </p>
</div>
