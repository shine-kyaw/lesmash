---
import type { Branch } from '../../lib/content';
import { href } from '../../lib/href';
interface Props { branches: Branch[] }
const { branches } = Astro.props;
---
<div class="mn-visit">
  <header class="mn-phead"><h2 class="mn-phead__title">Come find us</h2></header>
  <ul class="mn-rooms">
    {branches.map((b) => (
      <li class="mn-room">
        <h3 class="mn-room__name">{b.name}</h3>
        <p class="mn-room__addr">{b.addressLine}<br />{b.township}</p>
      </li>
    ))}
  </ul>
  <div class="mn-allergen">
    <p class="mn-allergen__title">Ask us about allergens</p>
    <p class="mn-allergen__body">We only publish allergen info once it's confirmed in writing. Got an allergy? Ask staff before you order.</p>
  </div>
  <a class="mn-visit__link" href={href('/visit')}>Rooms &amp; directions</a>
</div>
