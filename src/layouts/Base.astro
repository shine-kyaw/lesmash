---
import '../styles/global.css';
import '../styles/components.css';
import Head from '../components/Head.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { COPY } from '../data/copy';
import { getBranches } from '../lib/content';
import { asset } from '../lib/href';

interface Props {
  path: string;
  title: string;
  description: string;
  noindex?: boolean;
  schema?: unknown[];
}
const { path, title, description, noindex = false, schema = [] } = Astro.props;

const branches = await getBranches();
---
<!doctype html>
<html lang="en">
  <head>
    <Head path={path} title={title} description={description} noindex={noindex} schema={schema} />
  </head>
  <body>
    <a class="skip-link" href="#main">{COPY.labels.skip}</a>

    {/*
      The pre-launch banner is gone. It said no photography had been supplied
      and that the menu was unconfirmed; both were true when it was written and
      neither is now. The gaps that remain are named in
      docs/CONTENT-REGISTER.md, which is where a client-facing list belongs —
      not stapled to the top of every page a customer sees.
    */}

    <Header path={path} />

    <main id="main">
      <slot />
    </main>

    <Footer branches={branches} />

    <script src={asset('/scripts/app.js')} defer is:inline></script>
  </body>
</html>
