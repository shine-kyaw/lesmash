---
import '../styles/global.css';
import '../styles/components.css';
import Head from '../components/Head.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { COPY } from '../data/copy';
import { getBranches, orderableBranches, directionsUrl, IS_PREVIEW } from '../lib/content';

interface Props {
  path: string;
  title: string;
  description: string;
  noindex?: boolean;
  schema?: unknown[];
}
const { path, title, description, noindex = false, schema = [] } = Astro.props;

const branches = await getBranches();
const orderable = orderableBranches(branches);
const orderHref = orderable[0]?.foodpandaUrl ?? '/menu';
const directionsHref = branches[0] ? directionsUrl(branches[0]) : '/menu';
---
<!doctype html>
<html lang="en">
  <head>
    <Head path={path} title={title} description={description} noindex={noindex} schema={schema} />
  </head>
  <body>
    <a class="skip-link" href="#main">{COPY.labels.skip}</a>

    {IS_PREVIEW && (
      <div class="prelaunch" data-banner>
        <div class="wrap">
          <p>
            <b>Preview</b> — menu names, prices, hours and phone numbers are not confirmed by the
            restaurant yet. No photography has been supplied.
          </p>
        </div>
      </div>
    )}

    <Header path={path} />

    <main id="main">
      <slot />
    </main>

    <Footer branches={branches} />

    {/* Mobile only — two taps to order or find us, from anywhere. */}
    <div class="bar">
      <a class="btn btn--ember" href={orderHref}
         target={orderable[0] ? '_blank' : undefined}
         rel={orderable[0] ? 'noopener noreferrer' : undefined}
         data-analytics={orderable[0] ? 'foodpanda_outbound' : 'order_cta_click'}
         data-branch={orderable[0]?.slug ?? ''} data-source="bar">{COPY.cta.orderShort}</a>
      <a class="btn btn--ghost" href="/menu" data-source="bar">{COPY.nav.menu}</a>
      <a class="btn btn--ghost" href={directionsHref} target="_blank" rel="noopener noreferrer"
         data-analytics="directions_click" data-source="bar">{COPY.cta.directions}</a>
    </div>

    <div class="grain" aria-hidden="true"></div>

    {/* The preview bar is fixed, so the header and every sticky offset below it
        need its real height — which wraps to two lines on a narrow phone. */}
    {IS_PREVIEW && (
      <script is:inline>
        (function () {
          var bar = document.querySelector('[data-banner]');
          if (!bar) return;
          var set = function () {
            document.documentElement.style.setProperty('--banner-h', bar.offsetHeight + 'px');
          };
          set();
          window.addEventListener('resize', set);
        })();
      </script>
    )}

    <script src="/scripts/app.js" defer is:inline></script>
    <script src="/scripts/ember.js" defer is:inline></script>
  </body>
</html>
