---
import '../styles/global.css';
import '../styles/components.css';
import Head from '../components/Head.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { COPY } from '../data/copy';
import { getBranches, IS_PREVIEW } from '../lib/content';
import { asset } from '../lib/href';

interface Props {
  path: string;
  title: string;
  description: string;
  noindex?: boolean;
  schema?: unknown[];
}
const { path, title, description, noindex = false, schema = [] } = Astro.props;

const branches = await getBranches();
---
<!doctype html>
<html lang="en">
  <head>
    <Head path={path} title={title} description={description} noindex={noindex} schema={schema} />
  </head>
  <body>
    <a class="skip-link" href="#main">{COPY.labels.skip}</a>

    {IS_PREVIEW && (
      <div class="prelaunch" data-banner>
        <div class="wrap">
          <p>
            <b>Preview</b> — menu names, prices, hours and phone numbers are not confirmed by the
            restaurant yet. No photography has been supplied.
          </p>
        </div>
      </div>
    )}

    <Header path={path} />

    <main id="main">
      <slot />
    </main>

    <Footer branches={branches} />

    <script src={asset('/scripts/app.js')} defer is:inline></script>
    <script src={asset('/scripts/ember.js')} defer is:inline></script>
  </body>
</html>
