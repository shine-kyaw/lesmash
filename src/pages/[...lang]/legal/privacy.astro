---
import Base from '../../../layouts/Base.astro';
import { localePaths, localeFromParam, localePath, SITE } from '../../../lib/i18n';
import { t } from '../../../data/copy';
import { title, description } from '../../../lib/seo';

export function getStaticPaths() { return localePaths(); }

const locale = localeFromParam(Astro.params.lang);
const c = t(locale);

/*
 * Short, plain, bilingual (PRD §11.10).
 *
 * The text below describes what the site actually does today: no tracking
 * cookies, no third-party social scripts, no forms. If an analytics provider or
 * an enquiry form is added later, this page must be revised in the same release
 * — and reviewed by the client's legal adviser (content register C-18).
 */
const body = {
  en: {
    heading: 'Privacy',
    intro: `This notice explains how ${SITE.brand.legal} handles information on this website.`,
    sections: [
      {
        h: 'Cookies',
        p: 'This website sets no cookies for advertising or tracking. If you choose a branch, that choice is stored in your own browser so the site can remember it. It never leaves your device and we cannot read it.',
      },
      {
        h: 'Analytics',
        p: 'We measure how the site is used in aggregate — which pages are opened, and which buttons are pressed — so we can keep it fast and useful. This measurement is cookieless and does not identify you individually.',
      },
      {
        h: 'Third parties',
        p: 'We load no social media scripts, embeds or advertising pixels. Links to Facebook, Instagram, Google Maps and Foodpanda are ordinary links: nothing is sent to those companies until you choose to follow one, at which point their own privacy terms apply.',
      },
      {
        h: 'Ordering',
        p: 'Delivery orders are placed on Foodpanda, not here. Any name, address or payment detail you enter is handled by Foodpanda under their terms. We never see it.',
      },
      {
        h: 'Contact',
        p: 'For any question about this notice, please contact the restaurant using the details on the locations page.',
      },
    ],
  },
  my: {
    heading: 'ကိုယ်ရေးအချက်အလက် မူဝါဒ',
    intro: `ဤဝက်ဘ်ဆိုက်တွင် ${SITE.brand.legal} မှ အချက်အလက်များကို မည်သို့ ကိုင်တွယ်သည်ကို ရှင်းလင်းဖော်ပြထားပါသည်။`,
    sections: [
      {
        h: 'Cookies',
        p: 'ဤဝက်ဘ်ဆိုက်တွင် ကြော်ငြာ သို့မဟုတ် ခြေရာခံရန်အတွက် cookie များ မထားရှိပါ။ ဆိုင်ခွဲတစ်ခုကို ရွေးချယ်ပါက ထိုရွေးချယ်မှုကို သင့်ဘရောက်ဇာအတွင်း၌သာ သိမ်းဆည်းထားပြီး ကျွန်ုပ်တို့ ဖတ်ရှုနိုင်ခြင်း မရှိပါ။',
      },
      {
        h: 'အသုံးပြုမှု တိုင်းတာခြင်း',
        p: 'ဝက်ဘ်ဆိုက်ကို မြန်ဆန်ပြီး အသုံးဝင်စေရန်အတွက် စာမျက်နှာများ ဖွင့်ကြည့်မှုကို စုစုပေါင်းအနေဖြင့်သာ တိုင်းတာပါသည်။ ၎င်းသည် cookie မလိုအပ်ဘဲ သင့်ကိုယ်ရေးကိုယ်တာကို ခွဲခြားသတ်မှတ်ခြင်း မရှိပါ။',
      },
      {
        h: 'ပြင်ပဝန်ဆောင်မှုများ',
        p: 'လူမှုကွန်ရက် script များ၊ embed များနှင့် ကြော်ငြာ pixel များကို လုံးဝ မထည့်သွင်းထားပါ။ Facebook၊ Instagram၊ Google Maps နှင့် Foodpanda သို့ ချိတ်ဆက်မှုများသည် သာမန်လင့်ခ်များသာ ဖြစ်ပါသည်။',
      },
      {
        h: 'မှာယူခြင်း',
        p: 'ပို့ဆောင်မှု အော်ဒါများကို Foodpanda တွင် မှာယူရပါသည်။ သင်ထည့်သွင်းသော အမည်၊ လိပ်စာနှင့် ငွေပေးချေမှု အချက်အလက်များကို Foodpanda မှ ကိုင်တွယ်ပြီး ကျွန်ုပ်တို့ မမြင်ရပါ။',
      },
      {
        h: 'ဆက်သွယ်ရန်',
        p: 'ဤမူဝါဒနှင့် ပတ်သက်၍ မေးမြန်းလိုပါက ဆိုင်ခွဲများ စာမျက်နှာရှိ အချက်အလက်များဖြင့် ဆက်သွယ်နိုင်ပါသည်။',
      },
    ],
  },
}[locale];
---
<Base
  locale={locale}
  route="/legal/privacy"
  title={title(locale, body.heading)}
  description={description(locale, 'privacy')}
  noindex
>
  <div class="container">
    <section class="section stack">
      <h1>{body.heading}</h1>
      <p class="lede">{body.intro}</p>
      {body.sections.map((s) => (
        <div class="stack">
          <h2 style="font-size:var(--step-2)">{s.h}</h2>
          <p>{s.p}</p>
        </div>
      ))}
      <p style="margin-top:var(--sp-5)">
        <a href={localePath(locale, '/')}>{c.cta.backHome}</a>
      </p>
    </section>
  </div>
</Base>
