---
import Base from '../../../layouts/Base.astro';
import HoursTable from '../../../components/HoursTable.astro';
import OpenState from '../../../components/OpenState.astro';
import Placeholder from '../../../components/Placeholder.astro';
import { localeFromParam, localePath, type Locale } from '../../../lib/i18n';
import { t } from '../../../data/copy';
import { getBranches, directionsUrl, primaryPhone, L } from '../../../lib/content';
import { branchTitle } from '../../../lib/seo';
import { restaurantSchema, breadcrumbSchema } from '../../../lib/schema';

/**
 * One indexable page per branch (BR-02).
 *
 * Paths are generated by looping the branch collection, so publishing a third
 * branch produces its page, its schema, its sitemap entry and its chooser
 * option with no code change at all (PRD §14.2).
 */
export async function getStaticPaths() {
  const branches = await getBranches();
  return branches.flatMap((branch) => [
    { params: { lang: undefined, branch: branch.slug }, props: { branch } },
    { params: { lang: 'my', branch: branch.slug }, props: { branch } },
  ]);
}

const locale = localeFromParam(Astro.params.lang);
const { branch } = Astro.props;
const c = t(locale);

const phone = primaryPhone(branch);
const name = L(branch.name, locale) ?? branch.slug;
const township = L(branch.township, locale) ?? '';

const services = [
  { on: branch.hasDineIn, label: c.labels.dineIn },
  { on: branch.hasDelivery, label: c.labels.delivery },
  { on: branch.hasTakeaway, label: c.labels.takeaway },
];

const schema = [
  restaurantSchema(branch, locale, { withMenu: true }),
  breadcrumbSchema(
    [
      { name: c.nav.home, path: '/' },
      { name: c.nav.locations, path: '/locations' },
      { name, path: `/locations/${branch.slug}` },
    ],
    locale
  ),
];

const seoTitle = L(branch.seoTitle, locale) ?? branchTitle(locale, name, township);
const seoDescription =
  L(branch.seoDescription, locale) ??
  (locale === 'my'
    ? `${name} (${township})၊ ရန်ကုန်ရှိ Le SMASH ဆိုင်ခွဲ။ လိပ်စာ၊ ဖွင့်ချိန်၊ လမ်းညွှန်နှင့် ဆက်သွယ်ရန် အချက်အလက်များ။`
    : `Le SMASH in ${township}, Yangon. Address, opening hours, directions and how to order from the ${name} branch.`);
---
<Base
  locale={locale}
  route={`/locations/${branch.slug}`}
  title={seoTitle}
  description={seoDescription}
  schema={schema}
  branch={branch}
>
  <div class="container">
    <nav class="section" aria-label="Breadcrumb" style="padding-bottom:0">
      <p class="meta">
        <a href={localePath(locale, '/locations')}>{c.nav.locations}</a> / {name}
      </p>
    </nav>

    <section class="section stack">
      <h1>{name}</h1>
      <p class="lede">{township}, {L(branch.city, locale)}</p>
      <div class="badge-row">
        <OpenState hours={branch.openingHours} locale={locale} />
        {services.map((s) =>
          s.on === true ? <span class="badge">{s.label}</span>
          : s.on === null ? <span class="badge badge--warn">{s.label}: {c.labels.unconfirmed}</span>
          : <span class="badge badge--closed">{s.label}: {locale === 'my' ? 'မရှိပါ' : 'No'}</span>
        )}
      </div>

      <div class="btn-row">
        <a class="btn btn--primary" href={directionsUrl(branch, locale)!}
           target="_blank" rel="noopener noreferrer"
           data-analytics="directions_click" data-branch={branch.slug} data-source="branch_page">
          {c.cta.directions}
        </a>
        {phone && (
          <a class="btn btn--secondary" href={`tel:${phone.e164}`}
             data-analytics="phone_click" data-branch={branch.slug} data-source="branch_page">
            {c.cta.call}
          </a>
        )}
        {branch.foodpandaUrl && (
          <a class="btn btn--ghost" href={branch.foodpandaUrl}
             target="_blank" rel="noopener noreferrer"
             data-analytics="foodpanda_outbound" data-branch={branch.slug}
             data-source="branch_page" data-remember-branch={branch.slug}>
            {c.cta.order}
          </a>
        )}
      </div>
    </section>

    <section class="section grid grid--2">
      <div class="stack">
        <h2>{c.labels.address}</h2>
        <address style="font-style:normal">
          {L(branch.addressLine, locale)}<br />
          {township}<br />
          {L(branch.city, locale)}
        </address>
        {L(branch.branchNote, locale) && <p>{L(branch.branchNote, locale)}</p>}
        {!L(branch.branchNote, locale) && (
          <p class="meta">
            {locale === 'my'
              ? 'အထပ်၊ ဝင်ပေါက်နှင့် ကားရပ်နားရန် အချက်အလက်များကို မကြာမီ ဖြည့်စွက်ပါမည်။'
              : 'Floor, entrance and parking notes will be added once confirmed by the restaurant.'}
          </p>
        )}
        {L(branch.seatingNote, locale) && (
          <p class="badge">{L(branch.seatingNote, locale)}</p>
        )}
      </div>

      <div class="stack">
        <h2>{c.labels.hours}</h2>
        <HoursTable hours={branch.openingHours} locale={locale} />
        {phone && (
          <p><strong>{c.labels.phone}:</strong> <a href={`tel:${phone.e164}`}>{phone.display}</a></p>
        )}
        {!phone && <p class="meta">{c.labels.phone}: {c.labels.unconfirmed}</p>}
      </div>
    </section>

    {/* An exterior photograph is a functional requirement here, not decoration:
        a ground-floor unit inside a tower is genuinely hard to find without one
        (PRD §11.7). */}
    <section class="section">
      <h2 class="section-head">{name}</h2>
      <div class="grid grid--3">
        {branch.images.length > 0 ? (
          branch.images.map((img) =>
            img.src ? (
              <img src={img.src} alt={L(img.alt, locale) ?? ''} width="640" height="427"
                   loading="lazy" decoding="async" class="card" />
            ) : null
          )
        ) : (
          <>
            <Placeholder
              ratio="3x2"
              label={locale === 'my' ? 'ဆိုင်အပြင်ဘက် ဓာတ်ပုံ လိုအပ်သည်' : 'Exterior photograph required'}
            />
            <Placeholder ratio="3x2" label={c.state.noPhoto} />
            <Placeholder ratio="3x2" label={c.state.noPhoto} />
          </>
        )}
      </div>
    </section>

    <section class="section">
      <div class="btn-row">
        <a class="btn btn--secondary" href={localePath(locale, '/menu')}>{c.cta.fullMenu}</a>
        <a class="btn btn--ghost" href={localePath(locale, '/locations')}>{c.nav.locations}</a>
      </div>
    </section>
  </div>
</Base>
