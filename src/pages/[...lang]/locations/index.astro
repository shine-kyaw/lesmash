---
import Base from '../../../layouts/Base.astro';
import BranchCard from '../../../components/BranchCard.astro';
import Placeholder from '../../../components/Placeholder.astro';
import { localePaths, localeFromParam, localePath, SITE } from '../../../lib/i18n';
import { t } from '../../../data/copy';
import { getBranches, L } from '../../../lib/content';
import { title, description } from '../../../lib/seo';
import { branchListSchema, breadcrumbSchema } from '../../../lib/schema';

export function getStaticPaths() { return localePaths(); }

const locale = localeFromParam(Astro.params.lang);
const c = t(locale);
const branches = await getBranches();

/*
 * This page also absorbs the job a /contact page would do. Everything such a
 * page would hold — addresses, phones, hours, directions, social links — is
 * here and in the footer, where it is more useful; a separate contact page
 * would be a duplicate-content liability and a second bilingual surface to
 * maintain (PRD §9.4).
 */
const schema = [
  branchListSchema(branches, locale),
  breadcrumbSchema(
    [{ name: c.nav.home, path: '/' }, { name: c.nav.locations, path: '/locations' }],
    locale
  ),
];
const socials = [
  { label: 'Facebook', href: SITE.social.facebook },
  { label: 'Instagram', href: SITE.social.instagram },
  { label: 'TikTok', href: SITE.social.tiktok },
].filter((s) => s.href);
---
<Base
  locale={locale}
  route="/locations"
  title={title(locale, locale === 'my' ? 'ဆိုင်ခွဲများ' : 'Locations')}
  description={description(locale, 'locations')}
  schema={schema}
>
  <div class="container">
    <section class="section stack">
      <h1>{locale === 'my' ? 'ရန်ကုန်ရှိ ဆိုင်ခွဲများ' : 'Our branches in Yangon'}</h1>
      <p class="lede">
        {locale === 'my'
          ? `Le SMASH တွင် ဆိုင်ခွဲ ${branches.length} ခု ရှိပါသည်။`
          : `Le SMASH has ${branches.length} branches in Yangon.`}
      </p>
    </section>

    <section class="section">
      <div class="grid grid--2">
        {branches.map((branch) => <BranchCard locale={locale} branch={branch} />)}
      </div>
    </section>

    {/* A static map image linking out, never an embedded interactive map: an
        embed costs hundreds of KB and a third-party dependency to do a job a
        picture and a link do better on a slow phone (PRD §11.6). */}
    <section class="section">
      <Placeholder
        ratio="16x9"
        label={locale === 'my' ? 'မြေပုံပုံရိပ် လိုအပ်သည်' : 'Static map image required'}
      />
      <p class="meta" style="margin-top:var(--sp-3)">
        {locale === 'my'
          ? 'မြေပုံကို ပုံရိပ်အဖြစ်သာ ဖော်ပြပြီး Google Maps သို့ ချိတ်ဆက်ပါမည်။'
          : 'This is an optimised image that links out to Google Maps — not an embedded map.'}
      </p>
    </section>

    {socials.length > 0 && (
      <section class="section stack">
        <h2>{c.footer.followUs}</h2>
        <div class="btn-row">
          {socials.map((s) => (
            <a class="btn btn--ghost" href={s.href!} target="_blank" rel="noopener noreferrer"
               data-analytics="social_click" data-platform={s.label.toLowerCase()}>
              {s.label}
            </a>
          ))}
        </div>
      </section>
    )}
  </div>
</Base>
