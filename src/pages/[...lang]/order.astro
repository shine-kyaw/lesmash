---
import Base from '../../layouts/Base.astro';
import BranchChooserInline from '../../components/BranchChooser.astro';
import EditorialSlot from '../../components/EditorialSlot.astro';
import { localePaths, localeFromParam, localePath } from '../../lib/i18n';
import { t } from '../../data/copy';
import { EDITORIAL } from '../../data/editorial';
import { getBranches, directionsUrl, primaryPhone, L } from '../../lib/content';
import { title, description } from '../../lib/seo';

export function getStaticPaths() { return localePaths(); }

const locale = localeFromParam(Astro.params.lang);
const c = t(locale);
const branches = await getBranches();

/*
 * A deliberately thin page (PRD §9.3).
 *
 * Ordering is normally a modal chooser launched from the sticky bar, which costs
 * no page load. This URL exists anyway because a modal cannot be linked to from
 * outside the site, and three things need a stable destination: QR codes on
 * packaging and tables, the single "order" link in a social bio, and a
 * measurable landing point for outbound conversion.
 *
 * It carries noindex because it holds no unique content and would compete with
 * the branch pages in search.
 */
---
<Base
  locale={locale}
  route="/order"
  title={title(locale, locale === 'my' ? 'မှာယူရန်' : 'Order')}
  description={description(locale, 'order')}
  noindex
>
  <div class="container">
    <section class="section stack">
      <h1>{c.cta.chooseBranch}</h1>
      <EditorialSlot slot={EDITORIAL.orderExplainer} locale={locale} class="lede" />
    </section>

    <section class="section">
      <BranchChooserInline locale={locale} branches={branches} variant="inline" />
    </section>

    <section class="section">
      <h2 class="section-head">{locale === 'my' ? 'ဆိုင်သို့ လာရောက်ရန်' : 'Coming in instead?'}</h2>
      <div class="grid grid--2">
        {branches.map((branch) => {
          const phone = primaryPhone(branch);
          return (
            <div class="card branch-card">
              <h3 class="branch-card__name">{L(branch.name, locale)}</h3>
              <p class="branch-card__addr">
                {L(branch.addressLine, locale)}, {L(branch.township, locale)}
              </p>
              <div class="btn-row">
                <a class="btn btn--secondary" href={directionsUrl(branch, locale)!}
                   target="_blank" rel="noopener noreferrer"
                   data-analytics="directions_click" data-branch={branch.slug} data-source="order_page">
                  {c.cta.directionsShort}
                </a>
                {phone && (
                  <a class="btn btn--ghost" href={`tel:${phone.e164}`}
                     data-analytics="phone_click" data-branch={branch.slug} data-source="order_page">
                    {c.cta.callShort}
                  </a>
                )}
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <section class="section">
      <a href={localePath(locale, '/menu')}>{c.cta.fullMenu}</a>
    </section>
  </div>
</Base>
