---
import Base from '../../layouts/Base.astro';
import Placeholder from '../../components/Placeholder.astro';
import EditorialSlot from '../../components/EditorialSlot.astro';
import BranchCard from '../../components/BranchCard.astro';
import { localePaths, localeFromParam, localePath, SITE } from '../../lib/i18n';
import { t } from '../../data/copy';
import { EDITORIAL } from '../../data/editorial';
import { getBranches } from '../../lib/content';
import { title, description } from '../../lib/seo';
import { organizationSchema, breadcrumbSchema } from '../../lib/schema';

export function getStaticPaths() { return localePaths(); }

const locale = localeFromParam(Astro.params.lang);
const c = t(locale);
const branches = await getBranches();

/*
 * Every text block on this page is a content requirement, not agency-written
 * fiction. No founder narrative, opening date, award, sourcing claim or
 * certification appears here unless the client supplies it in writing
 * (PRD §11.8, §17.1).
 */
const schema = [
  organizationSchema(locale),
  breadcrumbSchema(
    [{ name: c.nav.home, path: '/' }, { name: c.nav.about, path: '/about' }],
    locale
  ),
];
---
<Base
  locale={locale}
  route="/about"
  title={title(locale, locale === 'my' ? 'ကျွန်ုပ်တို့အကြောင်း' : 'About')}
  description={description(locale, 'about')}
  schema={schema}
>
  <div class="container">
    <section class="section grid grid--2">
      <div class="stack">
        <p class="eyebrow">{c.nav.about}</p>
        <h1>{SITE.brand.legal}</h1>
        <EditorialSlot slot={EDITORIAL.aboutStory} locale={locale} class="lede" />
      </div>
      <Placeholder ratio="4x5" label={c.state.noPhoto} />
    </section>

    <section class="section stack">
      <h2>{locale === 'my' ? '"Smash" ဆိုတာ ဘာလဲ' : 'What "smash" means'}</h2>
      <EditorialSlot slot={EDITORIAL.howWeSmash} locale={locale} />
    </section>

    {/* The largest photography module on the site. The rooms are repeatedly
        praised in reviews and are the main thing justifying the top of the
        price range to a visitor who has not eaten here (PRD F6). */}
    <section class="section">
      <h2 class="section-head">{locale === 'my' ? 'ကျွန်ုပ်တို့၏ ဆိုင်ခန်း' : 'The space'}</h2>
      <div class="grid grid--3">
        <Placeholder ratio="3x2" label={c.state.noPhoto} />
        <Placeholder ratio="3x2" label={c.state.noPhoto} />
        <Placeholder ratio="3x2" label={c.state.noPhoto} />
        <Placeholder ratio="3x2" label={c.state.noPhoto} />
        <Placeholder ratio="3x2" label={c.state.noPhoto} />
        <Placeholder ratio="3x2" label={c.state.noPhoto} />
      </div>
    </section>

    <section class="section stack">
      <h2>{locale === 'my' ? 'ပမာဏနှင့် ရိုးသားမှု' : 'Portions, honestly'}</h2>
      <EditorialSlot slot={EDITORIAL.portionHonesty} locale={locale} class="lede" />
    </section>

    <section class="section stack">
      <h2>{locale === 'my' ? 'ထိုင်ခုံနှင့် ကြိုတင်မှာယူခြင်း' : 'Seating and reservations'}</h2>
      <EditorialSlot slot={EDITORIAL.seatingPolicy} locale={locale} />
    </section>

    <section class="section">
      <h2 class="section-head">{c.labels.branches}</h2>
      <div class="grid grid--2">
        {branches.map((branch) => <BranchCard locale={locale} branch={branch} />)}
      </div>
    </section>

    <section class="section">
      <a class="btn btn--primary" href={localePath(locale, '/menu')}>{c.cta.seeMenu}</a>
    </section>
  </div>
</Base>
