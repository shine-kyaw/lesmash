---
import Base from '../../layouts/Base.astro';
import MenuItemCard from '../../components/MenuItemCard.astro';
import CategoryChips from '../../components/CategoryChips.astro';
import EditorialSlot from '../../components/EditorialSlot.astro';
import { localePaths, localeFromParam, localePath } from '../../lib/i18n';
import { t } from '../../data/copy';
import { EDITORIAL } from '../../data/editorial';
import {
  getBranches, getCategories, getMenuItems, itemsInCategory, pricesAsOf, L,
} from '../../lib/content';
import { title, description } from '../../lib/seo';
import { menuSchema, breadcrumbSchema } from '../../lib/schema';

export function getStaticPaths() { return localePaths(); }

const locale = localeFromParam(Astro.params.lang);
const c = t(locale);
const branches = await getBranches();
const categories = await getCategories();
const items = await getMenuItems();

const populated = new Set(
  categories.filter((cat) => itemsInCategory(items, cat.slug).length > 0).map((cat) => cat.slug)
);
const food = categories.filter((cat) => cat.displayGroup === 'food' && populated.has(cat.slug));
const drinks = categories.filter((cat) => cat.displayGroup === 'drinks' && populated.has(cat.slug));
const asOf = pricesAsOf(items);

const filters = [
  { value: 'popular', label: c.tags.popular },
  { value: 'vegetarian', label: c.dietary.vegetarian },
  { value: 'spicy', label: c.tags.spicy },
  { value: 'value', label: c.tags.value },
];

const schema = [
  menuSchema(categories, items, locale),
  breadcrumbSchema(
    [{ name: c.nav.home, path: '/' }, { name: c.labels.menu, path: '/menu' }],
    locale
  ),
];
---
<Base
  locale={locale}
  route="/menu"
  title={title(locale, locale === 'my' ? 'မီနူးနှင့် ဈေးနှုန်းများ' : 'Menu & Prices')}
  description={description(locale, 'menu')}
  schema={schema}
>
  <div class="container">
    <section class="section" id="menu-top">
      <div class="stack">
        <h1>{locale === 'my' ? 'Le SMASH မီနူး — ရန်ကုန်' : 'Le SMASH Menu & Prices — Yangon'}</h1>

        {/* The price-context statement is a launch blocker in its own right:
            publishing a price without saying which channel it applies to is
            precisely the kind of half-truth this project exists to remove
            (MENU-13, PRD Q5). */}
        <EditorialSlot slot={EDITORIAL.priceContextStatement} locale={locale} class="lede" />

        {asOf && <p class="meta">{c.labels.pricesAsOf} {asOf}</p>}
      </div>
    </section>

    <CategoryChips locale={locale} categories={categories} populated={populated} />

    {/* Filters run over already-rendered DOM. Hidden until script confirms it
        can drive them, so a dead control never ships (MENU-06). */}
    <form class="section" data-filters hidden style="padding-top:var(--sp-4)">
      <fieldset style="border:0;padding:0">
        <legend class="eyebrow">{c.labels.filters}</legend>
        <div class="badge-row" style="margin-top:var(--sp-3)">
          {filters.map((f) => (
            <label class="badge" style="cursor:pointer;gap:var(--sp-2)">
              <input type="checkbox" value={f.value} />
              {f.label}
            </label>
          ))}
        </div>
      </fieldset>
      <p
        class="meta"
        style="margin-top:var(--sp-3)"
        role="status"
        aria-live="polite"
        data-filter-status
        data-template={`${c.labels.showing} {n} ${c.labels.items}`}
      ></p>
    </form>

    {food.map((category) => {
      const list = itemsInCategory(items, category.slug);
      return (
        <section class="section menu-section" id={`cat-${category.slug}`}>
          <div class="menu-section__head">
            <h2>{L(category.name, locale)}</h2>
            {L(category.serviceHours, locale) && (
              <span class="badge">{L(category.serviceHours, locale)}</span>
            )}
          </div>
          {L(category.description, locale) && <p class="lede">{L(category.description, locale)}</p>}
          <ul class="menu-list">
            {list.map((item) => (
              <MenuItemCard
                item={item}
                locale={locale}
                branches={branches}
                soldOut={branches.every((b) => b.soldOutItems.includes(item.slug))}
              />
            ))}
          </ul>
        </section>
      );
    })}

    {/* Three CMS categories, one heading — customers think "drinks", the CMS
        keeps them separate for merchandising (PRD §9.1). */}
    {drinks.length > 0 && (
      <section class="section menu-section" id="cat-drinks">
        <div class="menu-section__head"><h2>{c.labels.drinks}</h2></div>
        {drinks.map((category) => (
          <div id={`cat-${category.slug}`} style="margin-top:var(--sp-5)">
            <h3>{L(category.name, locale)}</h3>
            <ul class="menu-list" style="margin-top:var(--sp-4)">
              {itemsInCategory(items, category.slug).map((item) => (
                <MenuItemCard item={item} locale={locale} branches={branches} />
              ))}
            </ul>
          </div>
        ))}
      </section>
    )}

    <section class="section">
      <div class="notice notice--info">
        <strong>{c.labels.allergens}</strong>
        <p>
          {locale === 'my'
            ? 'ဓာတ်မတည့်မှုဆိုင်ရာ အချက်အလက်များကို ဆိုင်မှ အတည်ပြုပြီးမှသာ ဖော်ပြပါမည်။ ဓာတ်မတည့်မှုရှိပါက မမှာယူမီ ဝန်ထမ်းများထံ မေးမြန်းပါ။'
            : 'Allergen information is published only where the restaurant has confirmed it in writing. If you have an allergy, please ask staff before ordering.'}
        </p>
      </div>
    </section>
  </div>
</Base>
