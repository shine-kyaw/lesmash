---
import Base from '../layouts/Base.astro';
import HeroFilm from '../components/HeroFilm.astro';
import SpinRing from '../components/SpinRing.astro';
import Shot from '../components/Shot.astro';
import Slot from '../components/Slot.astro';
import Dish from '../components/Dish.astro';
import { href, asset } from '../lib/href';
import { COPY } from '../data/copy';
import { EDITORIAL } from '../data/editorial';
import { GALLERY_SECTIONS } from '../data/gallery';
import { SITE } from '../lib/site.config.mjs';
import { getBranches, getMenuItems, featuredItems } from '../lib/content';
import { title, DESCRIPTIONS } from '../lib/seo';
import { organizationSchema, websiteSchema, restaurantSchema } from '../lib/schema';

const branches = await getBranches();
const items = await getMenuItems();
const icons = featuredItems(items, 6);

const schema = [
  organizationSchema(),
  websiteSchema(),
  ...branches.map((b) => restaurantSchema(b, { withMenu: true })),
];

/*
 * The ticker is the client's own line, transcribed from their homepage mock —
 * including the four townships. It is their claim about their own coverage, so
 * it goes on verbatim rather than being rebuilt from the two branch records
 * this repo can verify.
 */
const ticker = [
  'Smashed to order',
  '3 rooms',
  '5 kitchens',
  'Kamayut Township',
  'Yankin Township',
  'Mayangone Township',
  'Hlaing Township',
  'Dine in',
  'Takeaway',
];
---
<Base path="/" title={title(null)} description={DESCRIPTIONS.home} schema={schema}>
  {/* First screen: the film, and nothing competing with it. */}
  <HeroFilm />

  {/*
    Second screen: the homepage as the client drew it. Headline, standfirst,
    two actions, two pictures and the spinning seal over the first — their
    layout, set in the type and the palette that came off their logo.
  */}
  <section class="section intro" id="home">
    <div class="wrap intro__grid">
      <div class="intro__copy">
        <h2 class="intro__head">Officially the<br />best burger<br />in town.</h2>
        <Slot slot={EDITORIAL.heroPositioning} class="lede" />
        <div class="btn-row">
          <a class="btn btn--ember" href={href('/menu')}>{COPY.cta.menu}</a>
          <a class="btn btn--ghost" href={href('/visit')}>Find us</a>
        </div>
      </div>

      <div class="intro__plates">
        <div class="intro__plate intro__plate--tall">
          <img src={asset('/media/burger.jpg')}
               alt="A Le SMASH burger held in one hand, the patties visible in profile"
               width="1008" height="976" loading="lazy" decoding="async" />
          <SpinRing class="intro__ring" />
        </div>
        <div class="intro__plate">
          <img src={asset('/media/sear.jpg')} alt="A plate leaving the Le SMASH pass"
               width="1000" height="1250" loading="lazy" decoding="async" />
        </div>
      </div>
    </div>
  </section>

  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      {[0, 1].map(() => (
        <div style="display:inline-flex">
          {ticker.map((line) => <span class="marquee__item">{line}</span>)}
        </div>
      ))}
    </div>
  </div>

  {/* The Icons — the brief's own name for the handful of dishes that carry the
      brand. Six of them here, the full menu one tap away. */}
  {icons.length > 0 && (
    <section class="section">
      <div class="wrap">
        <div class="sec-head">
          <p class="sec-head__index">01</p>
          <h2>Le SMASH Icons</h2>
          <a class="tlink sec-head__link" href={href('/menu')}>Full menu</a>
        </div>
        <ul class="dishes reveal">
          {icons.map((item) => <Dish item={item} branches={branches} />)}
        </ul>
      </div>
    </section>
  )}

  {/* Story teaser. */}
  <section class="section band--ink">
    <div class="wrap split split--wide-left">
      <div class="stack-lg reveal">
        <p class="label">02</p>
        <h2>American flavour,<br /><span class="script">French precision.</span></h2>
        <Slot slot={EDITORIAL.story} class="lede" />
        <a class="tlink" href={href('/story')}>Read our story</a>
      </div>
      <div class="figure figure--wide reveal">
        <Shot ratio="3x2" caption="The room" />
      </div>
    </div>
  </section>

  {/* Gallery teaser — the six archive sections, named on the client's brief. */}
  <section class="section">
    <div class="wrap">
      <div class="sec-head">
        <p class="sec-head__index">03</p>
        <h2>The archive</h2>
        <a class="tlink sec-head__link" href={href('/gallery')}>Open the gallery</a>
      </div>
      <ul class="tiles reveal">
        {GALLERY_SECTIONS.map((s) => (
          <li class="tile">
            <a href={`${href('/gallery')}#${s.slug}`}>
              <Shot ratio="4x3" caption={s.name} />
              <span class="tile__name">{s.name}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* Visit teaser. The rooms and the delivery map live on their own page. */}
  <section class="section band--red">
    <div class="wrap">
      <div class="sec-head">
        <p class="sec-head__index">04</p>
        <h2>Find Le SMASH near you</h2>
      </div>
      <p class="lede">Or see if we deliver to your area.</p>
      <div class="rooms">
        {branches.map((branch) => (
          <div class="room">
            <p class="label">{branch.township}</p>
            <p class="room__name">{branch.name}</p>
          </div>
        ))}
        <div class="room room--more">
          <p class="label">{SITE.geo}</p>
          <p class="room__name">Three rooms, five kitchens</p>
        </div>
      </div>
      <div class="btn-row" style="margin-top:var(--s7)">
        <a class="btn btn--cream" href={href('/visit')}>Visit us</a>
      </div>
    </div>
  </section>
</Base>
