---
import Base from '../layouts/Base.astro';
import HeroFilm from '../components/HeroFilm.astro';
import SpinRing from '../components/SpinRing.astro';
import Shot from '../components/Shot.astro';
import Slot from '../components/Slot.astro';
import Dish from '../components/Dish.astro';
import { href, asset } from '../lib/href';
import { COPY } from '../data/copy';
import { EDITORIAL } from '../data/editorial';
import { GALLERY_SECTIONS } from '../data/gallery';
import { SITE } from '../lib/site.config.mjs';
import { getBranches, getMenuItems, featuredItems } from '../lib/content';
import { title, DESCRIPTIONS } from '../lib/seo';
import { organizationSchema, websiteSchema, restaurantSchema } from '../lib/schema';

const branches = await getBranches();
const items = await getMenuItems();
const icons = featuredItems(items, 6);

const schema = [
  organizationSchema(),
  websiteSchema(),
  ...branches.map((b) => restaurantSchema(b, { withMenu: true })),
];

/*
 * The ticker is the client's own line, transcribed from their homepage mock —
 * including the four townships. It is their claim about their own coverage, so
 * it goes on verbatim rather than being rebuilt from the two branch records
 * this repo can verify.
 */
const ticker = [
  'Smashed to order',
  '3 rooms',
  '5 kitchens',
  'Kamayut Township',
  'Yankin Township',
  'Mayangone Township',
  'Hlaing Township',
  'Dine in',
  'Takeaway',
];
---
<Base path="/" title={title(null)} description={DESCRIPTIONS.home} schema={schema}>
  {/* First screen: the film, and nothing competing with it. */}
  <HeroFilm />

  {/*
    Second screen: the homepage as the client drew it. Headline, standfirst,
    two actions, two pictures and the spinning seal over the first — their
    layout, set in the type and the palette that came off their logo.
  */}
  <section class="section intro" id="home">
    <div class="wrap intro__grid">
      <div class="intro__copy">
        <h2 class="intro__head">Officially the<br />best burger<br />in town.</h2>
        <Slot slot={EDITORIAL.heroPositioning} class="lede" />
        <div class="btn-row">
          <a class="btn btn--ember" href={href('/menu')}>{COPY.cta.menu}</a>
          <a class="btn btn--ghost" href={href('/visit')}>Find us</a>
        </div>
      </div>


      {/*
        Their mock puts a photograph of the room here with the seal over it, and
        a panel of the monogram beside it. Both exist now: the room, and the
        pattern from their brand pack — with the cut-out burger standing on it,
        which is the one asset in the library that can sit on any ground.
      */}
      <div class="intro__plates">
        <div class="intro__plate intro__plate--tall">
          <img src={asset('/media/rooms/evening.jpg')}
               alt="The Le SMASH room in the evening, neon on"
               width="1600" height="1067" loading="lazy" decoding="async" />
          <SpinRing class="intro__ring" />
        </div>
        <div class="intro__plate intro__plate--pattern"
             style={"background-image:url(" + asset("/brand/pattern-monogram.png") + ")"}>
          <img class="intro__cutout" src={asset('/brand/hero-burger.png')}
               alt="A double Le SMASH burger, both patties visible in profile"
               width="689" height="516" loading="lazy" decoding="async" />
        </div>
      </div>
    </div>
  </section>

  <div class="marquee" aria-hidden="true">
    <div class="marquee__track">
      {[0, 1].map(() => (
        <div style="display:inline-flex">
          {ticker.map((line) => <span class="marquee__item">{line}</span>)}
        </div>
      ))}
    </div>
  </div>

  {/* The Icons — the brief's own name for the handful of dishes that carry the
      brand. Six of them here, the full menu one tap away. */}
  {icons.length > 0 && (
    <section class="section">
      <div class="wrap">
        <div class="sec-head">
          <p class="sec-head__index">01</p>
          <h2>Le SMASH Icons</h2>
          <a class="tlink sec-head__link" href={href('/menu')}>Full menu</a>
        </div>
        <ul class="dishes reveal">
          {icons.map((item) => <Dish item={item} branches={branches} />)}
        </ul>
      </div>
    </section>
  )}

  {/*
    Our Story, in place of a page of its own.
    The brief warns the homepage should "immediately establish the personality
    of Le SMASH without containing too much information", so the story is two
    blocks here rather than the three it had as a route: where it came from, and
    what the press does. Where it is going now closes the page on the red band,
    next to the rooms it is about.
  */}
  <section class="section" id="story">
    <div class="wrap track">
      <div class="track__rail">
        <p class="label">Our story</p>
        <p class="track__numeral" aria-hidden="true">02</p>
      </div>

      <div class="split split--wide-left">
        <div class="stack-lg reveal">
          <h2>American flavour,<br /><span class="script">French precision.</span></h2>
          {/* C-10 and C-15. The founding year the brief says "must be
              included", the people and the reason are all the client's to give
              — nothing here will be written for them. */}
          <Slot slot={EDITORIAL.story} class="lede" />
          <Slot slot={EDITORIAL.founding} />
        </div>
        <div class="figure figure--tall reveal">
          <img src={asset('/media/rooms/counter.jpg')}
               alt="The Le SMASH counter and stools before service"
               width="1600" height="1067" loading="lazy" decoding="async" />
        </div>
      </div>
    </div>
  </section>

  <section class="section band--ink">
    <div class="wrap track">
      <div class="track__rail">
        <p class="label">The press</p>
        <p class="track__numeral" aria-hidden="true">03</p>
      </div>
      <div class="split">
        <div class="figure figure--wide reveal">
          <img src={asset('/media/story/on-the-press.jpg')}
               alt="A cook pressing balls of beef flat on the plancha"
               width="1600" height="1067" loading="lazy" decoding="async" />
        </div>
        <div class="stack-lg reveal">
          <h2>Pressed once,<br /><span class="script">hard.</span></h2>
          <Slot slot={EDITORIAL.howWeSmash} />
        </div>
      </div>
    </div>
  </section>

  {/* Gallery teaser — the seven archive sections, named on the client's brief. */}
  <section class="section">
    <div class="wrap">
      <div class="sec-head">
        <p class="sec-head__index">04</p>
        <h2>The archive</h2>
        <a class="tlink sec-head__link" href={href('/gallery')}>Open the gallery</a>
      </div>
      <ul class="tiles reveal">
        {GALLERY_SECTIONS.map((s) => (
          <li class="tile">
            <a href={`${href('/gallery')}#${s.slug}`}>
              {s.items[0] ? (
                <img src={asset(`/media/gallery/${s.slug}/${s.items[0].src}`)}
                     alt={s.items[0].alt} width="1200" height="900"
                     class="shot--4x3" loading="lazy" decoding="async" />
              ) : (
                <Shot ratio="4x3" caption={s.name} />
              )}
              <span class="tile__name">{s.name}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {/* Visit teaser, which also closes the story: the rooms, and where they are
      going next. The addresses and the delivery map live on their own page. */}
  <section class="section band--red">
    <div class="wrap">
      <div class="sec-head">
        <p class="sec-head__index">05</p>
        <h2>Three rooms,<br /><span class="script">and counting.</span></h2>
      </div>
      <Slot slot={EDITORIAL.future} class="lede" />
      <div class="rooms">
        {branches.map((branch) => (
          <div class="room">
            <p class="label">{branch.township}</p>
            <p class="room__name">{branch.name}</p>
          </div>
        ))}
        <div class="room room--more">
          <p class="label">{SITE.geo}</p>
          <p class="room__name">Find Le SMASH near you</p>
        </div>
      </div>
      <div class="btn-row" style="margin-top:var(--s7)">
        <a class="btn btn--cream" href={href('/visit')}>Visit us</a>
      </div>
    </div>
  </section>
</Base>
