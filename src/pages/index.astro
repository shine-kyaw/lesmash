---
import Base from '../layouts/Base.astro';
import Slot from '../components/Slot.astro';
import Ticker from '../components/Ticker.astro';
import '../styles/pages/home.css';
import { href, asset } from '../lib/href';
import { EDITORIAL } from '../data/editorial';
import { getBranches, getMenuItems, itemsInCategory } from '../lib/content';
import { title, DESCRIPTIONS } from '../lib/seo';
import { organizationSchema, websiteSchema, restaurantSchema } from '../lib/schema';

const branches = await getBranches();
const items = await getMenuItems();
// Burgers carry no prices anywhere on this page: they are unconfirmed.
const burgers = itemsInCategory(items, 'burgers');

const schema = [
  organizationSchema(),
  websiteSchema(),
  ...branches.map((b) => restaurantSchema(b, { withMenu: true })),
];

/* The four doors — the client's "Option 1". `hint` is the header link each one
   lights up while it is hovered or focused. */
const doors = [
  { label: 'Our Story', to: '/story', hint: '/story', img: '/media/home/post-1-2.jpg', pos: '50% 55%', cap: 'Where it started.' },
  { label: 'Menu', to: '/menu', hint: '/menu', img: '/media/home/spicy-bacon.jpg', pos: '50% 62%', cap: 'Smashed to order.' },
  { label: 'Outlets', to: '/visit', hint: '/visit', img: '/media/home/mhk1766-copy.jpg', pos: '38% 40%', cap: 'Three rooms, five kitchens.' },
  { label: 'Campaigns', to: '/gallery#campaigns', hint: '/gallery', img: '/media/home/copy-of-38.jpg', pos: '45% 50%', cap: 'Pop-ups, parties, collabs.' },
];

const teasers = [
  { name: 'Gallery', note: 'Posters, parties, plates', to: '/gallery', img: '/media/events/mhk2601-copy.jpg', pos: '50% 40%' },
  { name: 'Collaborations', note: 'Le SMASH × friends', to: '/collaborations', img: '/media/campaigns/announcement.jpg', pos: '50% 45%' },
  { name: 'Merch', note: 'Wear it', to: '/merch', img: '/media/merch/le-smash-t-shirt-mockup.jpg', pos: '30% 40%' },
];
---
<Base path="/" title={title(null)} description={DESCRIPTIONS.home} schema={schema}>
  <script is:inline src={asset('/scripts/early/hm.js')}></script>

  {/* 1 — the smash. Real text in the h1; the slam is script-driven. */}
  <section class="hm-hero" data-hm-hero aria-label="Le SMASH Burgers &amp; Co.">
    <div class="hm-hero__stage" data-hm-stage>
      <video class="hm-hero__video" autoplay muted playsinline preload="auto"
             poster={asset('/media/home/hero-poster.jpg')} aria-hidden="true" tabindex="-1" data-hm-video>
        <source src={asset('/media/home/hero-720.mp4')} type="video/mp4" media="(max-width: 767px)" />
        <source src={asset('/media/home/hero.mp4')} type="video/mp4" />
      </video>
      <div class="hm-hero__scrim"></div>
    </div>
    <h1 class="hm-hero__title" data-hm-title>
      <span class="hm-hero__slam" data-hm-slam>
        <span class="hm-hero__le" aria-hidden="true">Le</span>
        <span class="visually-hidden">Le </span><span class="hm-hero__word" data-hm-word aria-hidden="true">{[...'SMASH'].map((c) => <span class="hm-ch" data-hm-ch>{c}</span>)}</span><span class="visually-hidden">SMASH</span><span class="visually-hidden"> Burgers &amp; Co.</span>
      </span>
      <span class="hm-hero__sub" aria-hidden="true">Smashed to order · Yangon</span>
    </h1>
  </section>

  {/* The client's ticker, under the hero as their mock draws it. */}
  <Ticker />

  {/* 2 — four doors */}
  <section class="hm-doors" id="doors" aria-label="Where to next">
    <ul class="hm-doors__row" data-hm-doors>
      {doors.map((d, i) => (
        <li class="hm-door" data-hint={d.hint}>
          <a class="hm-door__link" href={href(d.to)}>
            <img class="hm-door__img" src={asset(d.img)} alt="" width="1600" height="1067"
                 loading="lazy" decoding="async" style={`object-position:${d.pos}`} />
            <span class="hm-door__plain">{d.label}</span>
            <span class="hm-door__cap" aria-hidden="true">{d.cap}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  {/* 3 — officially the best burger in town */}
  <section class="hm-best" id="home" data-hm-best>
    <div class="wrap hm-best__grid">
      <div class="hm-best__copy">
        <h2 class="hm-best__head" data-hm-pop>Officially the <em>best burger</em> in town.</h2>
        <Slot slot={EDITORIAL.heroPositioning} class="lede" />
        <div class="btn-row">
          <a class="btn btn--ember" href={href('/menu')}>See the menu</a>
        </div>
      </div>
      <div class="hm-best__art" aria-hidden="true">
        <div class="hm-best__panel">
          <img class="hm-best__burger" data-hm-burger src={asset('/brand/hero-burger.png')} alt=""
               width="689" height="516" loading="lazy" decoding="async" />
        </div>
      </div>
    </div>
  </section>

  {/* 4 — the line-up */}
  {burgers.length > 0 && (
    <section class="hm-line" data-hm-line aria-labelledby="hm-line-title">
      <div class="hm-line__pin">
        <div class="wrap hm-line__head">
          <h2 class="hm-line__title" id="hm-line-title">The <span>line-up</span></h2>
          <a class="tlink" href={href('/menu')}>Full menu</a>
        </div>
        <div class="hm-line__viewport" data-hm-viewport>
          <ul class="hm-line__track" data-hm-track>
            {burgers.map((b, i) => (
              <li class="hm-card" data-hm-card>
                <a class="hm-card__in" href={href('/menu') + '#' + b.slug} style="text-decoration:none;color:inherit" data-hm-inner>
                  <figure class="hm-card__fig">
                    <img src={asset(b.image?.src ?? '')} alt={b.image?.alt ?? b.name}
                         width="1024" height="1365" loading="lazy" decoding="async" />
                    <h3 class="hm-card__name">{b.name}</h3>
                  </figure>
                  <p class="hm-card__desc">{b.description}</p>
                </a>
              </li>
            ))}
            <li class="hm-card hm-card--end" data-hm-card>
              <a class="hm-card__more" data-hm-inner href={href('/menu')}>
                <b>The whole menu</b>
                <span class="label" style="color:var(--cream)">Brunch, mains, snacks →</span>
              </a>
            </li>
          </ul>
        </div>
      </div>
    </section>
  )}

  {/* 5 — small teaser row */}
  <section class="hm-more" aria-label="More Le SMASH">
    <div class="wrap">
      <ul class="hm-more__row">
        {teasers.map((t) => (
          <li class="hm-more__item">
            <a href={href(t.to)}>
              <img src={asset(t.img)} alt="" width="1600" height="1067" loading="lazy" decoding="async" style={`object-position:${t.pos}`} />
              <span class="hm-more__name">{t.name}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Base>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);
  const $ = <T extends Element = HTMLElement>(s: string, r: ParentNode = document) => r.querySelector<T>(s);
  const $$ = <T extends Element = HTMLElement>(s: string, r: ParentNode = document) => Array.from(r.querySelectorAll<T>(s));
  const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ------------------------------------------------------------ 1. hero */
  /*
   * The film is one press: the plate meets the beef at about 0.5s and stops at
   * about 0.85s, then four seconds of sizzle. So the letters drop in over the
   * beef and get smashed flat by the same plate, on the same frame, then spring
   * back up as the patty spreads. The film plays once and holds on its last
   * frame (the steam is still rising there) instead of jump-cutting back.
   */
  (() => {
    const video = $<HTMLVideoElement>('[data-hm-video]');
    const slamEl = $('[data-hm-slam]');
    const word = $('[data-hm-word]');
    const chars = $$('[data-hm-ch]');
    const stage = $('[data-hm-stage]');
    const le = $('.hm-hero__le');
    const sub = $('.hm-hero__sub');
    if (!video || !slamEl || !word || !chars.length) return;

    if (reduced) {
      video.removeAttribute('autoplay');
      video.pause();
      return;
    }

    const CONTACT = 0.5;     // plate touches the beef (clip time, s)
    const FLAT = 0.85;       // plate stops
    let fired = false;

    gsap.set(slamEl, { opacity: 1 });
    gsap.set(chars, { yPercent: -120, opacity: 0, scaleY: 1.18, scaleX: 0.9, transformOrigin: '50% 100%' });
    gsap.set([le, sub], { opacity: 0, y: 14 });

    // The letters hang above the patty before the press, one after another.
    const hang = gsap.timeline({ paused: true })
      .to(chars, { yPercent: 0, opacity: 1, duration: 0.42, ease: 'power3.out', stagger: 0.05 })
      .to(le, { opacity: 1, y: 0, duration: 0.5, ease: 'power2.out' }, 0.1);

    const press = () => {
      if (fired) return;
      fired = true;
      const span = (FLAT - CONTACT) / (video.playbackRate || 1);
      gsap.timeline()
        // Squashed by the plate: flatter, wider, spreading out from the centre.
        .to(chars, {
          scaleY: 0.62, scaleX: 1.22, duration: span, ease: 'power2.in',
          x: (i: number) => (i - (chars.length - 1) / 2) * 6,
        })
        .to(stage, { y: 3, duration: 0.06, yoyo: true, repeat: 1, ease: 'power1.inOut' }, '<' + (span * 0.8).toFixed(2))
        // The pressure comes off: letters rise back, a little wider than before.
        .to(chars, { scaleY: 1, scaleX: 1.04, x: 0, duration: 0.9, ease: 'power3.out' }, '+=0.25')
        .to(sub, { opacity: 1, y: 0, duration: 0.6, ease: 'power2.out' }, '<0.2')
        // And the frame drifts in slowly while it sizzles.
        .fromTo(stage, { scale: 1 }, { scale: 1.06, duration: 6, ease: 'none' }, '<');
    };

    let hung = false;
    const tick = (t: number) => {
      if (!hung && t > 0.02) { hung = true; hang.play(); }
      if (!fired && t >= CONTACT) press();
    };

    video.playbackRate = 0.85;   // the press reads heavier a touch slower
    video.addEventListener('timeupdate', () => tick(video.currentTime));
    if ('requestVideoFrameCallback' in video) {
      const loop = (_n: number, meta: { mediaTime: number }) => {
        tick(meta.mediaTime);
        if (!fired) (video as any).requestVideoFrameCallback(loop);
      };
      (video as any).requestVideoFrameCallback(loop);
    }
    // Hold on the last frame rather than snapping back to the raw patty.
    video.addEventListener('ended', () => { video.pause(); });

    // Autoplay refused (data saver, low power): run the same sequence on a timer.
    setTimeout(() => {
      if (!hung && (video.paused || video.currentTime === 0)) {
        hung = true; hang.play();
        gsap.delayedCall(0.6, press);
      }
    }, 1400);
    video.play?.().catch(() => {});
  })();

  /* ------------------------------------------------------------ 2. doors */
  (() => {
    const doors = $$('.hm-door');
    const setHint = (path: string | null) => {
      $$('.hdr__nav a').forEach((a) => a.classList.remove('hm-hint'));
      if (path) $$(`.hdr__nav a[href$="${path}"]`).forEach((a) => a.classList.add('hm-hint'));
    };
    doors.forEach((d) => {
      const path = d.dataset.hint ?? null;
      d.addEventListener('mouseenter', () => setHint(path));
      d.addEventListener('mouseleave', () => setHint(null));
      d.addEventListener('focusin', () => setHint(path));
      d.addEventListener('focusout', () => setHint(null));
    });
  })();

  /* ------------------------------------------------------ 3. best burger */
  if (!reduced) {
    const best = $('[data-hm-best]');
    if (best) {
      const head = $('[data-hm-pop]');
      if (head) gsap.from(head, {
        y: 70, rotation: -2, opacity: 0, duration: 0.9, ease: 'back.out(1.7)',
        scrollTrigger: { trigger: head, start: 'top 85%', once: true },
      });
      const burger = $('[data-hm-burger]');
      if (burger) gsap.from(burger, {
        y: -160, rotation: -14, opacity: 0, duration: 0.7, ease: 'back.out(1.7)',
        scrollTrigger: { trigger: burger, start: 'top 90%', once: true },
      });
    }
  }

  /* ------------------------------------------------------- 4. line-up */
  (() => {
    const section = $('[data-hm-line]');
    const track = $('[data-hm-track]');
    const viewport = $('[data-hm-viewport]');
    if (!section || !track || !viewport || reduced) return;
    const cards = $$('[data-hm-card]', track);
    const inners = (c: HTMLElement) => $('[data-hm-inner]', c) as HTMLElement;

    const smash = (c: HTMLElement) => {
      gsap.timeline()
        .fromTo(inners(c), { opacity: 0, y: -110, scaleX: 0.96, scaleY: 1.08 },
          { opacity: 1, y: 0, scaleX: 1.06, scaleY: 0.9, duration: 0.2, ease: 'power4.in' })
        .to(inners(c), { scaleX: 1, scaleY: 1, duration: 0.55, ease: 'back.out(2)' });
    };

    const mm = gsap.matchMedia();

    mm.add('(min-width: 900px)', () => {
      gsap.set(cards.map(inners), { opacity: 0 });
      const dist = () => Math.max(0, track.scrollWidth - window.innerWidth + 8);
      const tween = gsap.to(track, {
        x: () => -dist(), ease: 'none',
        scrollTrigger: {
          trigger: section, start: 'top top', end: () => '+=' + dist(),
          pin: true, scrub: 0.6, invalidateOnRefresh: true, anticipatePin: 1,
        },
      });
      let live = false;
      const pending: HTMLElement[] = [];
      ScrollTrigger.create({
        trigger: section, start: 'top 75%', once: true,
        onEnter: () => { live = true; pending.splice(0).forEach((c, i) => gsap.delayedCall(i * 0.12, () => smash(c))); },
      });
      cards.forEach((c) => {
        ScrollTrigger.create({
          trigger: c, containerAnimation: tween, start: 'left 94%', once: true,
          onEnter: () => (live ? smash(c) : pending.push(c)),
        });
      });
    });

    mm.add('(max-width: 899.98px)', () => {
      gsap.set(cards.map(inners), { opacity: 0 });
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          smash(e.target as HTMLElement);
          io.unobserve(e.target);
        });
      }, { threshold: 0.35 });
      cards.forEach((c) => io.observe(c));
      return () => io.disconnect();
    });
  })();
</script>
