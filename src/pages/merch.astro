---
import Base from '../layouts/Base.astro';
import MerchHead from '../components/merch/MerchHead.astro';
import Rack from '../components/merch/Rack.astro';
import Lineup from '../components/merch/Lineup.astro';
import Detail from '../components/merch/Detail.astro';
import '../styles/pages/merch.css';
import { href } from '../lib/href';
import { SITE } from '../lib/site.config.mjs';
import { title, DESCRIPTIONS } from '../lib/seo';
---
<Base path="/merch" title={title('Merch')} description={DESCRIPTIONS.merch}>
  {/* Pre-hide flag so animated pieces never flash their end state first.
      Skipped for reduced motion; removed again if the script never reports in. */}
  <script is:inline>
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.documentElement.classList.add('mc-js');
      setTimeout(function () { if (!window.__mcReady) document.documentElement.classList.remove('mc-js'); }, 5000);
    }
  </script>

  <MerchHead />
  <Rack />
  <Lineup />

  <section class="mc-close" aria-labelledby="mc-close-h">
    <div class="wrap mc-close__in">
      <h2 id="mc-close-h">Want a closer look?</h2>
      <p class="lede">Follow along on Instagram, or come and see us in one of the rooms.</p>
      <div class="btn-row">
        <a class="btn btn--ember" href={SITE.social.instagram} target="_blank" rel="noopener">Instagram</a>
        <a class="btn btn--ghost" href={href('/visit')}>Find a room</a>
      </div>
    </div>
  </section>

  <Detail />
</Base>

<script>
  import '../components/merch/client';
</script>
