---
import Base from '../layouts/Base.astro';
import RoomCard from '../components/visit/RoomCard.astro';
import TeamShowcase from '../components/visit/TeamShowcase.astro';
import '../styles/pages/visit.css';
import { asset } from '../lib/href';
import { SITE } from '../lib/site.config.mjs';
import { getBranches } from '../lib/content';
import { title, DESCRIPTIONS } from '../lib/seo';
import { breadcrumbSchema, restaurantSchema } from '../lib/schema';

const branches = await getBranches();
const schema = [
  ...branches.map((b) => restaurantSchema(b)),
  breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Visit Us', path: '/visit' }]),
];

/* Room photographs. The Junction Square opening arch is unmistakable; the
   carriage room is not tied to a branch in anything the client has told us, so
   its alt text stays neutral. */
const roomPhotos: Record<string, { photo: string; alt: string; focus: string }> = {
  'junction-square': {
    photo: '/media/highlights/mhk1780-copy.jpg',
    alt: 'The Le SMASH shopfront at Junction Square with a red, white and black balloon arch over the door',
    focus: '50% 40%',
  },
  yankin: {
    // A table, not a room: no supplied photo is identified as Yankin's.
    photo: '/media/highlights/7.jpg',
    alt: 'Hands reaching across a Le SMASH table spread of brunch plates',
    focus: '50% 50%',
  },
};

/* The client's own coverage line, from their homepage mock. The townships come
   from their copy and are theirs to stand behind. */
const townships = ['Kamayut', 'Yankin', 'Mayangone', 'Hlaing'];
const deliverable = branches.filter((b) => b.foodpandaUrl && b.hasDelivery);
---
<Base path="/visit" title={title('Visit Us')} description={DESCRIPTIONS.visit} schema={schema}>
  <div class="vs-page" style={`--vs-mono:url(${asset('/brand/pattern-monogram.png')})`}>

    <section class="vs-hero brand-red" aria-labelledby="vs-h1">
      <div class="vs-hero__stickers" aria-hidden="true">
        <img src={asset('/brand/sticker-pork.png')} alt="" width="320" height="320" decoding="async" />
      </div>
      <div class="wrap">
        <p class="label label--ember">Visit us</p>
        <h1 id="vs-h1">
          <span class="vs-mask"><span>Find Le SMASH</span></span>
          <span class="vs-mask"><span><span class="script">near you.</span></span></span>
        </h1>
        <p class="lede">Or see if we deliver to your area.</p>
        <div class="btn-row">
          <a class="btn btn--cream" href="#rooms">The rooms</a>
          <a class="btn btn--ghost" href="#team">Meet the crew</a>
          <a class="btn btn--ghost" href="#delivery">Delivery</a>
        </div>
      </div>
    </section>

    {/* The rooms, laid out as stops on one line. */}
    <section class="vs-rooms dark" id="rooms" aria-labelledby="vs-rooms-h">
      <div class="wrap">
        <div class="vs-sec-head">
          <p class="label label--brass">All aboard</p>
          <h2 id="vs-rooms-h">The <span class="script">rooms</span></h2>
          <p class="lede">Tap an address to open it in Google Maps.</p>
        </div>

        <div class="vs-rooms__list" data-rooms>
          {branches.map((b, i) => (
            <RoomCard stop={i + 1} branch={b} {...(roomPhotos[b.slug] ? { photo: roomPhotos[b.slug].photo, photoAlt: roomPhotos[b.slug].alt, focus: roomPhotos[b.slug].focus } : {})} />
          ))}
        </div>

        {/* One number for all of it: it is the number on their own Facebook
            page, and which room it rings is not stated anywhere public. */}
        {SITE.phone && (
          <div class="vs-board" data-board>
            <div>
              <h3>Hungry? <span class="script">Ring us.</span></h3>
              <p>One number for Le SMASH. Opening hours for each room are still to be published.</p>
            </div>
            <a class="btn btn--ember" href={`tel:${SITE.phone.e164}`}
               data-analytics="phone_click" data-source="visit">
              Call {SITE.phone.display}
            </a>
          </div>
        )}
      </div>
    </section>

    <TeamShowcase />

    <section class="vs-delivery" id="delivery" aria-labelledby="vs-del-h">
      <div class="wrap">
        <div class="vs-sec-head">
          <p class="label">Delivery</p>
          <h2 id="vs-del-h">Where we <span class="script">deliver</span></h2>
        </div>
        <ul class="vs-metro" data-metro>
          {townships.map((t) => <li data-stop>{t} <small>Township</small></li>)}
        </ul>
        {deliverable.length > 0 && (
          <div class="vs-delivery__actions">
            {deliverable.map((b) => (
              <a class="btn btn--cream" href={b.foodpandaUrl!} target="_blank" rel="noopener noreferrer"
                 data-analytics="order_click" data-branch={b.slug} data-platform="foodpanda" data-source="visit_delivery">
                Order from {b.name}
              </a>
            ))}
          </div>
        )}
        <p class="vs-note">
          Township boundaries and the areas each kitchen covers are still to be confirmed.
        </p>
      </div>
    </section>

  </div>
</Base>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    gsap.registerPlugin(ScrollTrigger);
    const rnd = (n: number) => (Math.random() * 2 - 1) * n;

    // Hero: lines rise out of their masks, stickers pop in with a tilt.
    const tl = gsap.timeline({ defaults: { ease: 'power3.out' } });
    tl.from('.vs-hero .vs-mask > span', { yPercent: 115, duration: 0.9, stagger: 0.12 })
      .from('.vs-hero .lede, .vs-hero .btn-row', { y: 20, opacity: 0, duration: 0.6, stagger: 0.1 }, '-=0.4')
      .from('.vs-hero__stickers img', { scale: 0, rotation: () => rnd(30), duration: 0.7, ease: 'back.out(1.7)', stagger: 0.12 }, 0.3);

    // Rooms: each stop lands with a little overshoot as it scrolls in.
    gsap.utils.toArray<HTMLElement>('[data-room]').forEach((el) => {
      gsap.from(el, {
        y: 70, opacity: 0, rotation: rnd(3), scale: 0.95, duration: 0.9, ease: 'back.out(1.7)',
        clearProps: 'transform,opacity',
        scrollTrigger: { trigger: el, start: 'top 88%', once: true },
      });
    });
    gsap.from('.vs-roundel', {
      scale: 0, duration: 0.5, ease: 'back.out(2.5)', stagger: 0.15,
      scrollTrigger: { trigger: '[data-rooms]', start: 'top 85%', once: true },
    });
    gsap.from('[data-board]', {
      y: 40, opacity: 0, rotation: -1.5, duration: 0.8, ease: 'back.out(1.5)', clearProps: 'transform,opacity',
      scrollTrigger: { trigger: '[data-board]', start: 'top 92%', once: true },
    });

    // Delivery stops board one after another.
    gsap.from('[data-stop]', {
      y: 30, opacity: 0, duration: 0.6, stagger: 0.15, ease: 'back.out(1.7)', clearProps: 'transform,opacity',
      scrollTrigger: { trigger: '[data-metro]', start: 'top 88%', once: true },
    });
  }
</script>
