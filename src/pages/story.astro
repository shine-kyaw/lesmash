---
import Base from '../layouts/Base.astro';
import Slot from '../components/Slot.astro';
import Folder from '../components/story/Folder.astro';
import Chapter from '../components/story/Chapter.astro';
import Print from '../components/story/Print.astro';
import Press from '../components/story/Press.astro';
import Lightbox from '../components/story/Lightbox.astro';
import { EDITORIAL } from '../data/editorial';
import { asset, href } from '../lib/href';
import { title, DESCRIPTIONS } from '../lib/seo';
import '../styles/pages/story.css';
---
<Base path="/story" title={title('Our Story')} description={DESCRIPTIONS.story}>
  {/* Pre-hide flag so animated pieces never flash their end state first.
      Skipped for reduced motion; removed again if the script never reports in. */}
  <script is:inline>
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      document.documentElement.classList.add('st-js');
      setTimeout(function () { if (!window.__stReady) document.documentElement.classList.remove('st-js'); }, 5000);
    }
  </script>

  <Folder />

  <Chapter id="st-beginning" num="01" kicker="The beginning" title="Sign, paint, grill" sticker="/brand/sticker-pork.png">
    <p slot="text" class="lede">Three snapshots from before it was a restaurant: the Le SMASH sign going up over the shopfront, the room coming together, and the first patties and bacon on the grill.</p>
    <Print src="/media/story/1.jpg" cap="The sign goes up" rotate={-4} dy={0} fix="tape"
      alt="Two people standing on rattan stools in front of a dark timber shopfront, reaching up to fix the black Le SMASH Burgers & Co. sign and the SMASH strip above the door." />
    <Print src="/media/story/2.jpg" cap="Building the room" rotate={3} dy={40} fix="clip" w={0.95}
      alt="Three people fitting out the black-framed shopfront: one stands on a stool reaching up to the window panes while another holds paper to the glass." />
    <Print src="/media/story/3.jpg" cap="First smash" rotate={-2} dy={-10} fix="pin" w={0.9}
      alt="Strips of bacon and two raw beef patties on a flat steel grill, a cook's tattooed hands working a spatula and a knife." />
  </Chapter>

  {/* Chronology from the posters themselves (checked 4 Nov 2026): RTH pop-up
      Apr 2025 → Junction Square opening 10 May 2025 (easel poster in
      pop-up-b.jpg; the client's files call these "JS Grand Opening") → soft
      opening 16 Nov–3 Dec 2025 → official opening of a new location 3 Dec 2025
      → Chit Thu Bazaar Mar 2026. Which room opened in December is not stated,
      so the page doesn't say. */}
  <Chapter id="st-popup" num="02" kicker="Pop-up · April 2025" title="Le SMASH pops up" flip tone="raised" sticker="/brand/sticker-fish.png">
    <Fragment slot="text">
      <p class="lede">A Le SMASH Pop-up at RTH Junction Square, 3&ndash;12 April 2025.</p>
    </Fragment>
    <Print src="/media/campaigns/lesmash-pop-up.jpg" cap="Le SMASH Pop-up, April 3–12, 2025" rotate={3} dy={0} fix="pin" w={1}
      alt="Pop-up poster: Le SMASH Pop-up at RTH Junction Square, April 3–12, 2025, two hands holding a black Le SMASH card and a green RTH card on a deep red background." />
  </Chapter>

  <Chapter id="st-grand" num="03" kicker="Grand opening · 10 May 2025" title="Junction Square, doors open" sticker="/brand/sticker-lecoq.png">
    <Fragment slot="text">
      <p class="lede">Balloons up, ribbon cut. The poster on the easel by the door: Grand Opening, mystery draw, 10 May 2025.</p>
    </Fragment>
    <Print src="/media/story/le-smash-js-grand-opening.jpg" cap="Cutting the ribbon" rotate={-3} dy={0} fix="clip" w={1.35}
      alt="Four people hold scissors to a red ribbon with big red bows in front of the Le SMASH doorway, beneath a red, black and white balloon arch." />
    <Print src="/media/story/pop-up-b.jpg" cap="Grand Opening, 10 May 2025" rotate={2} dy={30} fix="tape" w={1.05}
      alt="The black timber Le SMASH shopfront with a spiral red, black and white balloon arch, flame-print panels and an easel poster reading Grand Opening, May 10, 2025." />
    <Print src="/media/story/le-smash-js-grand-opening-b.jpg" cap="Everyone out front" rotate={-2} dy={-14} fix="pin" w={1.35}
      alt="A large group of the team and friends gathered in front of the Le SMASH shopfront and balloon arch, many pointing one finger to the sky." />
    <Print src="/media/story/pop-up.jpg" cap="Under the balloon arch" rotate={3} dy={24} fix="tape" w={1.05}
      alt="Three people in black Le SMASH tees stand under a red, black and white balloon arch below the Le SMASH Burgers & Co. sign, with a video camera in the foreground." />
    <Print src="/media/story/pop-up-b-b.jpg" cap="The bar, ribbons on the stools" rotate={-2} dy={10} fix="clip" w={1.05}
      alt="The wooden bar with SMASH lettering along the front, rattan stools tied with red, black and white ribbon bows, and a neon SMASH sign behind." />
  </Chapter>

  <Chapter id="st-soft" num="04" kicker="Soft opening · Nov 2025" title="Stop by anytime" flip tone="raised" sticker="/brand/sticker-beef.png">
    <Fragment slot="text">
      <p class="lede">Then a new room. The doors opened softly first: 16 November to 3 December 2025. The invitation said it plainly.</p>
      <p class="st-quote">&ldquo;Please feel free to stop by anytime.&rdquo;</p>
    </Fragment>
    <Print src="/media/campaigns/invitation.jpg" cap="Soft opening, 16 Nov – 3 Dec" rotate={-3} dy={0} fix="clip" w={1.25}
      alt="Soft Opening invitation poster: a red card pulled from a white envelope reading November 16th to December 3rd, please feel free to stop by anytime, over a blurred red dining room." />
  </Chapter>

  <Chapter id="st-official" num="05" kicker="Official opening · 3 Dec 2025" title="A new beginning" sticker="/brand/sticker-pork.png">
    <Fragment slot="text">
      <p class="lede">The official Grand Opening, 3 December 2025. In their own words:</p>
      <p class="st-quote">&ldquo;Our Grand Opening marks not only a new location but a new upgrade in taste, design, and experience.&rdquo;</p>
    </Fragment>
    <Print src="/media/campaigns/grand-opening-fi.jpg" cap="The invitation: 3rd Dec" rotate={4} dy={0} fix="tape" w={1}
      alt="Official Grand Opening poster: a halftone photo of a hand holding a cheeseburger, red scribbled loops and a red oval reading 3rd Dec 2025." />
  </Chapter>

  <Chapter id="st-bazaar" num="06" kicker="Out in the city · Mar 2026" title="Chit Thu Bazaar" flip tone="raised" sticker="/brand/sticker-beef.png">
    <Fragment slot="text">
      <p class="lede">Le SMASH &times; Ellie&rsquo;s, at Chit Thu Bazaar. 1st&ndash;2nd March 2026, 3:00 PM to 10:00 PM, The Secretariat, Yangon. Booth FB-24.</p>
    </Fragment>
    <Print src="/media/campaigns/announcement.jpg" cap="Save the date" rotate={-3} dy={0} fix="clip" w={1.05}
      alt="Save the date poster for Le SMASH and Ellie's at Chit Thu Bazaar, 1st and 2nd March 2026, The Secretariat, Yangon, booth FB-24, with a red binder clip over a postcard." />
    <Print src="/media/story/le-smash-chit-thu-bazzar.jpg" cap="At the stall" rotate={3} dy={36} fix="tape" w={0.95}
      alt="Two of the team in black Le SMASH tees and black gloves, giving thumbs up in front of the Le SMASH signboard and the red-brick Secretariat building." />
  </Chapter>

  <Press />

  <section class="st-last" id="st-counting" aria-labelledby="st-last-h">
    <img class="st-sticker st-sticker--last" data-sticker src={asset('/brand/sticker-lecoq.png')} alt="" width="320" height="320" loading="lazy" decoding="async" />
    <div class="wrap st-last__grid">
      <ul class="st-board st-board--single" role="list">
        <Print src="/media/story/ko-nyi.jpg" cap="Ko Nyi" rotate={-3} dy={0} fix="tape" w={1.4}
          alt="A cook in a cream Le SMASH tee with the logo on the back, seen from behind in the kitchen, tying his apron." />
      </ul>
      <div class="st-last__text">
        <p class="label label--ember" data-rise>07 · And counting</p>
        <h2 id="st-last-h" class="st-last__title"><span class="st-mask"><span class="st-mask__in">Still <span class="script">smashing.</span></span></span></h2>
        <Slot slot={EDITORIAL.heroPositioning} class="lede st-last__line" />
        <div class="btn-row st-last__cta" data-rise>
          <a class="btn btn--ember" href={href('/menu')}>See the menu</a>
          <a class="btn btn--ghost" href={href('/visit')}>Find a room</a>
        </div>
      </div>
    </div>
  </section>

  <Lightbox />
</Base>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const rand = gsap.utils.random;

  /* ------------------------------------------------------------------ Lightbox */
  const lb = document.querySelector<HTMLDialogElement>('[data-lb]')!;
  const lbImg = lb.querySelector<HTMLImageElement>('[data-lb-img]')!;
  const lbCap = lb.querySelector<HTMLElement>('[data-lb-cap]')!;
  const lbNote = lb.querySelector<HTMLElement>('[data-lb-note]')!;
  const lbCount = lb.querySelector<HTMLElement>('[data-lb-count]')!;
  const lbFrame = lb.querySelector<HTMLElement>('.st-lb__frame')!;
  const lbStage = lb.querySelector<HTMLElement>('[data-lb-stage]')!;

  const items = [...document.querySelectorAll<HTMLElement>('[data-print]')].map((el) => ({
    el,
    btn: el.querySelector<HTMLButtonElement>('button')!,
    src: el.dataset.src || '',
    cap: el.dataset.cap || '',
    alt: el.dataset.alt || '',
    note: el.dataset.note || '',
    w: el.dataset.w || '',
    h: el.dataset.h || '',
  }));
  let cur = 0;

  function show(i: number, dir = 0) {
    cur = (i + items.length) % items.length;
    const it = items[cur];
    lbImg.src = it.src;
    lbImg.alt = it.alt;
    if (it.w) { lbImg.width = +it.w; lbImg.height = +it.h; }
    lbCap.textContent = it.cap;
    lbNote.textContent = it.note;
    lbCount.textContent = `${cur + 1} / ${items.length}`;
    const next = items[(cur + 1) % items.length], prev = items[(cur - 1 + items.length) % items.length];
    new Image().src = next.src; new Image().src = prev.src;
    if (!reduce) {
      gsap.fromTo(lbFrame,
        { x: dir * 70, rotation: dir ? dir * 5 : -6, scale: dir ? 0.94 : 0.7, opacity: 0 },
        { x: 0, rotation: rand(-1.6, 1.6), scale: 1, opacity: 1, duration: 0.55, ease: 'back.out(1.7)', overwrite: true });
    }
  }
  function openAt(i: number) {
    show(i, 0);
    if (!lb.open) lb.showModal();
    document.documentElement.classList.add('st-lock');
  }
  items.forEach((it, i) => it.btn.addEventListener('click', () => openAt(i)));
  document.querySelectorAll<HTMLElement>('[data-fp]').forEach((fp) => {
    fp.addEventListener('click', () => {
      const i = items.findIndex((it) => it.src === fp.dataset.src);
      if (i >= 0) openAt(i);
    });
  });
  const step = (d: number) => show(cur + d, d);
  lb.querySelector('[data-lb-prev]')!.addEventListener('click', () => step(-1));
  lb.querySelector('[data-lb-next]')!.addEventListener('click', () => step(1));
  lb.querySelector('[data-lb-close]')!.addEventListener('click', () => lb.close());
  lb.addEventListener('close', () => document.documentElement.classList.remove('st-lock'));
  lb.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowRight') { e.preventDefault(); step(1); }
    else if (e.key === 'ArrowLeft') { e.preventDefault(); step(-1); }
  });
  // Click on the dark surround closes; clicks on the print itself do not.
  lbStage.addEventListener('click', (e) => {
    const t = e.target as HTMLElement;
    if (!t.closest('.st-lb__frame') && !t.closest('figcaption')) lb.close();
  });
  // Swipe between prints on touch.
  let sx = 0, sy = 0;
  lbStage.addEventListener('pointerdown', (e) => { sx = e.clientX; sy = e.clientY; });
  lbStage.addEventListener('pointerup', (e) => {
    if (e.pointerType === 'mouse') return;
    const dx = e.clientX - sx, dy = e.clientY - sy;
    if (Math.abs(dx) > 50 && Math.abs(dx) > Math.abs(dy) * 1.4) step(dx < 0 ? 1 : -1);
  });

  /* ------------------------------------------------------------------ Motion */
  (window as any).__stReady = true;
  if (!reduce) {
    const open = document.querySelector<HTMLElement>('[data-open]')!;
    const folder = document.querySelector<HTMLElement>('[data-folder]')!;
    const cover = document.querySelector<HTMLElement>('[data-cover]')!;
    const fps = [...document.querySelectorAll<HTMLElement>('[data-fp]')];
    const hint = document.querySelector('[data-hint]');

    // Intro: headline rises out of its mask on load.
    gsap.set('[data-intro-line]', { yPercent: 115, opacity: 1 });
    gsap.set('[data-intro]', { opacity: 0, y: 10 });
    gsap.to('[data-intro-line]', { yPercent: 0, duration: 0.9, ease: 'power4.out', stagger: 0.12, delay: 0.15 });
    gsap.to('[data-intro]', { opacity: 1, y: 0, duration: 0.6, delay: 0.1 });

    // The folder opens as you scroll; prints leave it and land with overshoot.
    const fx = (fp: HTMLElement) => folder.offsetLeft + folder.offsetWidth / 2 - (fp.offsetLeft + fp.offsetWidth / 2);
    const fy = (fp: HTMLElement) => folder.offsetTop + folder.offsetHeight * 0.3 - (fp.offsetTop + fp.offsetHeight / 2);
    const tl = gsap.timeline({
      scrollTrigger: { trigger: open, start: 'top top', end: 'bottom bottom', scrub: 0.7, invalidateOnRefresh: true },
    });
    tl.fromTo(cover, { rotateY: 0 }, { rotateY: -158, ease: 'power2.inOut', duration: 0.9 }, 0);
    tl.to(hint, { opacity: 0, duration: 0.2 }, 0.05);
    fps.forEach((fp, i) => {
      const inner = fp.querySelector('.st-fp__in')!;
      tl.fromTo(inner,
        { x: () => fx(fp), y: () => fy(fp), scale: 0.18, rotation: rand(-30, 30), opacity: 0 },
        { x: 0, y: 0, scale: 1, rotation: 0, opacity: 1, ease: 'back.out(1.5)', duration: 1.1 },
        0.5 + i * 0.26);
    });
    tl.to(cover, { opacity: 0, duration: 0.3 }, 1.75);
    tl.to({}, { duration: 0.5 });

    // Chapters: text rises, prints pop out one after another, photos drift inside frames.
    document.querySelectorAll<HTMLElement>('[data-chapter], .st-last, .st-press').forEach((ch) => {
      const mask = ch.querySelectorAll('.st-mask__in');
      const rises = ch.querySelectorAll('[data-rise]');
      gsap.set(mask, { yPercent: 115, opacity: 1 });
      gsap.set(rises, { y: 26, opacity: 0 });
      ScrollTrigger.create({
        trigger: ch.querySelector('.st-chapter__text, .st-last__text, .st-press__text') || ch,
        start: 'top 82%', once: true,
        onEnter: () => {
          gsap.to(mask, { yPercent: 0, duration: 0.85, ease: 'power4.out' });
          gsap.to(rises, { y: 0, opacity: 1, duration: 0.7, ease: 'power2.out', stagger: 0.1, delay: 0.1 });
        },
      });
    });
    const prints = gsap.utils.toArray<HTMLElement>('.st-chapter .st-print, .st-last .st-print');
    gsap.set(prints, { opacity: 0, y: 90, scale: 0.55, rotation: () => rand(-16, 16) });
    ScrollTrigger.batch(prints, {
      start: 'top 92%', once: true,
      onEnter: (batch) => gsap.to(batch, {
        opacity: 1, y: 0, scale: 1, rotation: 0, duration: 0.95, ease: 'back.out(1.7)', stagger: 0.13,
      }),
    });
    prints.forEach((p) => {
      const img = p.querySelector('img');
      if (!img) return;
      gsap.fromTo(img, { yPercent: -5, scale: 1.12 }, {
        yPercent: 5, scale: 1.12, ease: 'none',
        scrollTrigger: { trigger: p, start: 'top bottom', end: 'bottom top', scrub: true },
      });
    });
    gsap.utils.toArray<HTMLElement>('[data-sticker]').forEach((s, i) => {
      gsap.fromTo(s, { rotation: -14 + i * 4, scale: 0.6, opacity: 0 }, {
        rotation: 8 - i * 3, scale: 1, opacity: 1, ease: 'back.out(1.7)', duration: 0.9,
        scrollTrigger: { trigger: s, start: 'top 90%', once: true },
      });
    });

    // The press: a ball of beef goes under the plate as you scroll.
    const press = document.querySelector<HTMLElement>('[data-press]');
    if (press) {
      const g = (s: string) => press.querySelector(s);
      const pt = gsap.timeline({
        scrollTrigger: { trigger: press, start: 'top top', end: 'bottom bottom', scrub: 0.6 },
      });
      pt.fromTo(g('[data-pr-plate]'), { y: -230 }, { y: -92, ease: 'power2.in', duration: 0.55 }, 0);
      pt.fromTo(g('[data-pr-ball]'), { scaleX: 1, scaleY: 1 }, { scaleX: 2.2, scaleY: 0.2, ease: 'power4.in', duration: 0.5 }, 0.55);
      pt.to(g('[data-pr-plate]'), { y: 0, ease: 'power4.in', duration: 0.5 }, 0.55);
      pt.fromTo(g('[data-pr-crust]'), { opacity: 0 }, { opacity: 1, duration: 0.25 }, 1.0);
      pt.to(g('[data-pr-plate]'), { y: -86, ease: 'power2.out', duration: 0.45 }, 1.1);
      pt.fromTo(g('.st-pr__steam'), { opacity: 0 }, { opacity: 1, duration: 0.4 }, 1.1);
      pt.to(g('.st-pr__tag'), { opacity: 0, duration: 0.2 }, 0.1);
      pt.to({}, { duration: 0.3 });
    }

    window.addEventListener('load', () => ScrollTrigger.refresh());
  }
</script>
