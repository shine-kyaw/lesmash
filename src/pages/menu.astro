---
import '../styles/pages/menu.css';
import Base from '../layouts/Base.astro';
import CoverPage from '../components/menu/CoverPage.astro';
import CardsPage from '../components/menu/CardsPage.astro';
import ListPage from '../components/menu/ListPage.astro';
import VisitPage from '../components/menu/VisitPage.astro';
import BackPage from '../components/menu/BackPage.astro';
import { buildPages, shortName } from '../components/menu/plan';
import { getBranches, getCategories, getMenuItems, itemsInCategory } from '../lib/content';
import { title, DESCRIPTIONS } from '../lib/seo';
import { menuSchema, breadcrumbSchema } from '../lib/schema';

const branches = await getBranches();
const categories = await getCategories();
const items = await getMenuItems();

const schema = [
  menuSchema(categories, items),
  breadcrumbSchema([{ name: 'Home', path: '/' }, { name: 'Menu', path: '/menu' }]),
];

const { pages, firstPageOf } = buildPages(categories, (slug) => itemsInCategory(items, slug), branches);
const jumps = categories
  .filter((c) => firstPageOf[c.slug] !== undefined)
  .map((c) => ({ label: shortName(c), page: firstPageOf[c.slug] }));
const pad = (n: number) => String(n).padStart(2, '0');
const pageLabel = (p: (typeof pages)[number]) =>
  p.kind === 'cover' ? 'Cover' :
  p.kind === 'cards' || p.kind === 'list' ? p.category.name :
  p.kind === 'visit' ? 'Come find us' : p.kind === 'back' ? 'Back cover' : 'Le SMASH';
---
<Base path="/menu" title={title('Menu')} description={DESCRIPTIONS.menu} schema={schema}>
  <section class="mn-head">
    <div class="wrap">
      <h1 class="mn-head__title">Flip it. <span class="script">Pick it.</span> Smash it.</h1>
      <nav class="mn-jump" aria-label="Jump to a section of the menu">
        {jumps.map((j) => (
          <a href={`#mn-p-${j.page}`} data-jump={j.page} data-analytics="menu_category_select">{j.label}</a>
        ))}
      </nav>
    </div>
  </section>

  <section class="mn" data-mn data-total={pages.length} aria-label="The Le SMASH menu">
    <div class="wrap mn__bar">
      <button type="button" class="mn-toggle" data-toggle hidden aria-pressed="false">
        <span data-toggle-label>View as list</span>
      </button>
    </div>

    <div class="mn-stage" data-stage>
      <div class="mn-book" data-book>
        <div class="mn-edge mn-edge--l" aria-hidden="true"></div>
        <div class="mn-edge mn-edge--r" aria-hidden="true"></div>
        <div class="mn-pages" data-pages>
          {pages.map((p, i) => (
            <article class={`mn-page mn-page--${p.kind}`} id={`mn-p-${i}`} data-page={i}
                     aria-label={`Page ${i + 1} of ${pages.length}: ${pageLabel(p)}`}>
              <div class="mn-page__in">
                {p.kind === 'cover' && <CoverPage />}
                {p.kind === 'cards' && <CardsPage category={p.category} items={p.items} part={p.part} parts={p.parts} eager={i <= 2} />}
                {p.kind === 'list' && <ListPage category={p.category} columns={p.columns} flow={p.flow} part={p.part} parts={p.parts} />}
                {p.kind === 'visit' && <VisitPage branches={p.branches} />}
                {p.kind === 'filler' && <BackPage filler />}
                {p.kind === 'back' && <BackPage />}
              </div>
              <span class="mn-page__no" aria-hidden="true">{pad(i + 1)}</span>
            </article>
          ))}
        </div>
        <button type="button" class="mn-curl" data-curl aria-label="Turn the page" hidden><span class="mn-curl__flap"></span></button>
      </div>
    </div>

    <div class="mn-controls" data-controls hidden>
      <button type="button" class="mn-nav" data-prev aria-label="Previous page"><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M15 4l-8 8 8 8" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
      <div class="mn-meter">
        <p class="mn-count" aria-live="polite"><span data-count>01</span> / <span data-of>{pad(pages.length)}</span></p>
      </div>
      <button type="button" class="mn-nav mn-nav--next" data-next aria-label="Next page"><span class="mn-nav__tx">Flip</span><svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M9 4l8 8-8 8" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/></svg></button>
    </div>
  </section>

  <section class="section band--ink mn-foot">
    <div class="wrap">
      <p class="label">Allergens</p>
      <p class="lede" style="margin-top:var(--s4)">
        We only publish allergen info once it's confirmed in writing.
        Got an allergy? Ask staff before you order.
      </p>
    </div>
  </section>
</Base>

<script>
  import "../components/menu/book.ts";
</script>
